#!/usr/bin/env perl
# The shell GNU parallel runs each job with, when BATS runs files in parallel.
#
# GNU parallel sets SIGALRM to ignored in itself (`$SIG{ALRM} = 'IGNORE'` in
# save_original_signal_handler: line 6352 of the 20261022 script, src/parallel:5531 of
# 20231122), and every job it forks inherits that. ansible-core treats an inherited ignored
# SIGALRM as an existing alarm handler and refuses a task `timeout:` ("An existing alarm
# handler was present"), so a playbook test that passes alone fails under `bats --jobs`.
#
# GNU parallel runs each job as `$PARALLEL_SHELL -c cmd` after the fork. A shell cannot reset
# a signal it inherited as ignored, but perl can, and the default disposition survives exec,
# so this restores SIGALRM and hands the job to /bin/sh. Perl is always present where GNU
# parallel runs: parallel is itself a perl script.
$SIG{ALRM} = "DEFAULT";
exec "/bin/sh", @ARGV;
