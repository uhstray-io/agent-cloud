# launch-gate environment. Rendered per deploy by the launch-gate deploy playbook from OpenBao and the
# inventory; never committed (.gitignore). Overwritten on every deploy: OpenBao is the source of truth,
# and this file is only the bridge compose reads (env_file, and the ${...} values in compose.yml).
#
# The gate reads its tokens from the environment, never from config.json (app/launch_gate.py,
# load_config): LAUNCH_GATE_SEMAPHORE_TOKEN, and one LAUNCH_GATE_CALLER_TOKEN_<NAME> per caller, each at
# least 32 characters. <NAME> is the caller name upper-cased, with '-' replaced by '_'.
LAUNCH_GATE_IMAGE={{ _launch_gate_image }}
LAUNCH_GATE_BIND={{ _launch_gate_bind }}
LAUNCH_GATE_PORT={{ _launch_gate_port }}
# The TLS name. compose.local.yml reads it as the local-dev network alias the local probes dial; production does
# not read it. Nothing here is a secret.
LAUNCH_GATE_TLS_NAME={{ _launch_gate_tls_name }}
LAUNCH_GATE_SEMAPHORE_TOKEN={{ secrets.semaphore_api_token }}
{% for _caller in _launch_gate_callers | sort %}
LAUNCH_GATE_CALLER_TOKEN_{{ _caller | upper | replace('-', '_') }}={{ secrets['caller_' ~ _caller ~ '_token'] }}
{% endfor %}
