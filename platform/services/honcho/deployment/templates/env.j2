{# honcho compose env — rendered by deploy-honcho.yml from OpenBao + inventory.
   Secrets (JWT secret, DB password) come from OpenBao via manage-secrets; the
   Gemini API key is a _shared_read from nemoclaw (which owns it). The rest is
   non-secret config. .env is gitignored and overwritten on every deploy.
   Do NOT edit by hand. #}
# --- compose substitution (image + published port/bind) ---
# Image is CI-built from the pinned upstream ref by build-honcho.yml and
# pushed to ghcr.io/uhstray-io/honcho; api + deriver share it.
HONCHO_IMAGE={{ honcho_image | default('ghcr.io/uhstray-io/honcho:' ~ (honcho_image_tag | default('v3.0.11'))) }}
HONCHO_BIND={{ honcho_bind | default('127.0.0.1') }}
HONCHO_PORT={{ honcho_port | default('8000') }}

# --- database (honcho's own Postgres+pgvector; internal-only) ---
# POSTGRES_* bootstrap the db container's superuser; honcho's alembic
# migrations run `CREATE EXTENSION IF NOT EXISTS vector` with it, so no
# init.sql is needed. DB_CONNECTION_URI is what the api/deriver dial.
POSTGRES_DB=honcho
POSTGRES_USER=honcho
POSTGRES_PASSWORD={{ secrets.honcho_db_password }}
DB_CONNECTION_URI=postgresql+psycopg://honcho:{{ secrets.honcho_db_password }}@honcho-db:5432/honcho

# --- cache + deriver queue (redis; internal-only) ---
# suppress=true: cache errors degrade to cache-miss instead of failing the
# request.
CACHE_ENABLED=true
CACHE_URL=redis://honcho-redis:6379/0?suppress=true

# --- auth: JWT on /v3 ---
# Every /v3 call carries a workspace/peer-scoped JWT signed with this secret.
# Team-member JWTs are minted post-deploy (POST /v3/keys) and stored under
# secret/services/honcho/tokens/<member> — the phase-4 evolve/team step, not
# this deploy. (/docs is gated at Caddy by Authentik forward_auth, not here.)
AUTH_USE_AUTH=true
AUTH_JWT_SECRET={{ secrets.honcho_jwt_secret }}

# --- LLM (D3 — Gemini interim) ---
# The deriver + dialectic need a TOOL-CALLING model. Every text-gen feature is
# pointed at Gemini: the upstream defaults are transport=openai, and no OpenAI
# key is provisioned here — any feature left on the default would fail at call
# time.
#
# Skynet swap (later, config-only — plan D3): flip each TRANSPORT below to
# `openai` and add per feature:
#   <FEATURE>_MODEL_CONFIG__OVERRIDES__BASE_URL=<skynet /v1>
#   <FEATURE>_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=SKYNET_API_KEY
# (plus SKYNET_API_KEY itself in this env). Served models MUST support tool
# calling.
LLM_GEMINI_API_KEY={{ secrets.gemini_api_key }}
DERIVER_MODEL_CONFIG__TRANSPORT=gemini
DERIVER_MODEL_CONFIG__MODEL={{ honcho_llm_model | default('gemini-2.5-flash') }}
SUMMARY_MODEL_CONFIG__TRANSPORT=gemini
SUMMARY_MODEL_CONFIG__MODEL={{ honcho_llm_model | default('gemini-2.5-flash') }}
# Dialectic reasoning levels — medium is the primary; the other levels get the
# same override so no level is left on the key-less openai default.
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL={{ honcho_llm_model | default('gemini-2.5-flash') }}
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL={{ honcho_llm_model | default('gemini-2.5-flash') }}
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL={{ honcho_llm_model | default('gemini-2.5-flash') }}
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL={{ honcho_llm_model | default('gemini-2.5-flash') }}
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL={{ honcho_llm_model | default('gemini-2.5-flash') }}
# Dream (background consolidation) text-gen — same interim override.
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=gemini
DREAM_DEDUCTION_MODEL_CONFIG__MODEL={{ honcho_llm_model | default('gemini-2.5-flash') }}
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=gemini
DREAM_INDUCTION_MODEL_CONFIG__MODEL={{ honcho_llm_model | default('gemini-2.5-flash') }}

# --- embeddings: OFF for the interim ---
# EMBEDDING_MODEL_CONFIG__TRANSPORT stays at the upstream default (`openai`)
# and is deliberately NOT configured — no OpenAI key exists here, so vector /
# semantic search is off until the skynet swap. EMBED_MESSAGES=false stops the
# api from attempting a per-message embed against that key-less default. When
# skynet serves an embedding model, re-enable EMBED_MESSAGES, point
# EMBEDDING_MODEL_CONFIG__* at it, and set EMBEDDING_VECTOR_DIMENSIONS to
# match the served model.
EMBED_MESSAGES=false
