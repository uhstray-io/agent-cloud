{# postiz COMPOSE-SUBSTITUTION env — rendered by deploy-postiz.yml.

   This file holds ONLY values compose itself must substitute: image pins, the
   published bind/port, and the two Postgres passwords (those containers are
   configured through compose `environment:`, unlike the app).

   App configuration does NOT belong here — it goes in config/postiz.env
   (upstream "Option B"), which compose never reads and therefore never
   $-interpolates. Putting the ~60 social provider secrets through this file
   would let a `$` in any client secret be silently mangled.

   .env is gitignored and overwritten on every deploy. Do NOT edit by hand. #}
# --- image pins ---
# Upstream app. Pinned, not :latest (plan/archive/development/SOURCE-OF-TRUTH.md §1.2).
POSTIZ_IMAGE={{ postiz_image | default('ghcr.io/gitroomhq/postiz-app:' ~ (postiz_image_tag | default('v2.23.0'))) }}
POSTIZ_POSTGRES_IMAGE={{ postiz_postgres_image | default('docker.io/postgres:17-alpine') }}
POSTIZ_REDIS_IMAGE={{ postiz_redis_image | default('docker.io/redis:7.2') }}
# Temporal's Postgres stays on 16 — Temporal 1.28 supports up to PG16, so it
# deliberately does not track postiz's 17.
TEMPORAL_IMAGE={{ temporal_image | default('docker.io/temporalio/auto-setup:1.28.1') }}
TEMPORAL_POSTGRES_IMAGE={{ temporal_postgres_image | default('docker.io/postgres:16-alpine') }}

# --- published bind + port (the ONLY published port in the stack) ---
# Local: loopback. Prod: the host's LAN address so the central Caddy VM can
# reach it; the host firewall then permits this port from the Caddy host only.
POSTIZ_BIND={{ postiz_bind | default('127.0.0.1') }}
POSTIZ_PORT={{ postiz_port | default('5000') }}

# --- postiz's own Postgres (internal; no host port) ---
POSTIZ_POSTGRES_DB={{ postiz_postgres_db | default('postiz') }}
POSTIZ_POSTGRES_USER={{ postiz_postgres_user | default('postiz') }}
POSTIZ_DB_PASSWORD={{ secrets.postiz_db_password }}

# --- the workflow engine's Postgres (internal; no host port) ---
TEMPORAL_DB_PASSWORD={{ secrets.postiz_temporal_db_password }}
