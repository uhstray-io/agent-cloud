{# postiz APP CONFIG — upstream "Option B": bind-mounted read-only at
   /config/postiz.env, rendered by deploy-postiz.yml from OpenBao + inventory.

   Compose never reads this file, so nothing here is $-interpolated — which is
   the whole reason Option B was chosen: a `$` inside a social provider client
   secret would be silently mangled if these values went through compose.

   Secrets come from OpenBao via manage-secrets (jwt_secret, db_password,
   temporal_db_password generated once and reused; the nine social credentials
   seeded by seed-postiz-secrets.yml; the OIDC client secret a _shared_read from
   authentik, which owns it). Everything else is non-secret config.

   Rendered 0600 and gitignored; overwritten on every deploy. Do NOT edit by
   hand — change inventory or OpenBao and redeploy. #}
# ── URLs ────────────────────────────────────────────────────────────────────
# These MUST match the URL a browser actually uses. The OIDC redirect is
# derived from FRONTEND_URL by upstream (see the OIDC block below), so a
# mismatch here is rejected by Authentik as an unregistered redirect. Locally
# that includes the :8443 port unless `make local-https` is running, which is
# why this is an inventory variable per environment and never a constant.
MAIN_URL={{ postiz_public_url }}
FRONTEND_URL={{ postiz_public_url }}
NEXT_PUBLIC_BACKEND_URL={{ postiz_public_url }}/api
# Server-side, inside the container: the frontend's SSR calls the backend
# directly on loopback, not back out through Caddy.
BACKEND_INTERNAL_URL=http://localhost:3000

# ── Core ────────────────────────────────────────────────────────────────────
# Signing secret for sessions AND API keys. STABLE across redeploys —
# manage-secrets generates it once into OpenBao and reuses it thereafter;
# regenerating would invalidate every session and every API key n8n holds.
JWT_SECRET={{ secrets.postiz_jwt_secret }}
DATABASE_URL=postgresql://{{ postiz_postgres_user | default('postiz') }}:{{ secrets.postiz_db_password }}@postiz-postgres:5432/{{ postiz_postgres_db | default('postiz') }}
REDIS_URL=redis://postiz-redis:6379
# The workflow engine that executes scheduled publishing. Without this the app
# starts but scheduled posts never fire.
TEMPORAL_ADDRESS=temporal:7233
# Required for self-hosting (upstream's branding/product-line switch).
IS_GENERAL=true
# Run the scheduled-task workers in this container.
RUN_CRON=true

# NOTE: NOT_SECURED is deliberately absent. Upstream documents it as dev-only
# ("disables security checks"). The prior developer-machine .env set it; it is
# NOT carried over to a host reachable from the internet.

# ── Registration lockdown ───────────────────────────────────────────────────
# Upstream allows a single signup then closes when true. The flip is a config
# change, not a manual step on the host: deploy with false, sign in once via
# Authentik to establish the account, set postiz_disable_registration=true in
# inventory, redeploy. Re-asserted on every later deploy.
DISABLE_REGISTRATION={{ 'true' if (postiz_disable_registration | default(false) | bool) else 'false' }}

# ── Storage ─────────────────────────────────────────────────────────────────
# Local named volume, served back through the app's own nginx at /uploads/.
# Swapping to Cloudflare R2 later is config-only: STORAGE_PROVIDER=cloudflare
# plus the CLOUDFLARE_* keys from OpenBao.
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# ── Automation API ──────────────────────────────────────────────────────────
# Per-hour ceiling on the public create-post endpoint. This is the budget n8n
# workflows must respect; it is templated so the contract in
# context/use-cases.md can state a real number.
API_LIMIT={{ postiz_api_limit | default(90) }}

# ── OIDC (native) against Authentik ─────────────────────────────────────────
# Read from upstream source, not the docs — three facts that constrain this:
#
#  1. The redirect URI is HARDCODED as `${FRONTEND_URL}/settings` in both the
#     authorization-link and token-exchange paths. There is no configurable
#     callback path, so Authentik's Strict redirect must be exactly
#     {{ postiz_public_url }}/settings.
#  2. The scope is HARDCODED to `openid profile email`. Upstream's own compose
#     and .env.example carry a POSTIZ_OAUTH_SCOPE variable that the provider
#     code never reads — it is dead config, so it is NOT templated here.
#  3. Identity comes from the USERINFO endpoint (email + sub claims via the
#     access token), not from an id_token. So the provider's signing key and
#     PKCE are irrelevant, while the `email` scope mapping is load-bearing —
#     without it, sign-in fails on a missing claim.
#
# Enabling this disables upstream's GitHub/Google login providers, which is
# intended: Authentik is the platform IdP.
POSTIZ_GENERIC_OAUTH=true
NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME={{ postiz_oauth_display_name | default('Authentik') }}
NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL={{ postiz_oauth_logo_url | default('https://raw.githubusercontent.com/walkxcode/dashboard-icons/master/png/authentik.png') }}
POSTIZ_OAUTH_URL={{ postiz_authentik_base | default('https://auth.agent-cloud.test:8443') }}
# Authentik's OIDC endpoints are zone-level, not per-application.
POSTIZ_OAUTH_AUTH_URL={{ postiz_authentik_base | default('https://auth.agent-cloud.test:8443') }}/application/o/authorize/
POSTIZ_OAUTH_TOKEN_URL={{ postiz_authentik_base | default('https://auth.agent-cloud.test:8443') }}/application/o/token/
POSTIZ_OAUTH_USERINFO_URL={{ postiz_authentik_base | default('https://auth.agent-cloud.test:8443') }}/application/o/userinfo/
POSTIZ_OAUTH_CLIENT_ID={{ postiz_oidc_client_id | default('postiz') }}
POSTIZ_OAUTH_CLIENT_SECRET={{ secrets.postiz_oidc_client_secret }}

# ── Social platform credentials ─────────────────────────────────────────────
# Seeded into OpenBao by seed-postiz-secrets.yml. Every slot renders even when
# unseeded (empty), so enabling a new platform later is a seed + redeploy with
# NO change to committed code.
#
# IMPORTANT (operator): each platform's OAuth redirect/callback URI must be
# updated at that platform's developer console to {{ postiz_public_url }}.
# Connecting an account fails until that is done — automation cannot reach
# those consoles.
X_API_KEY={{ secrets.postiz_x_api_key | default('') }}
X_API_SECRET={{ secrets.postiz_x_api_secret | default('') }}
LINKEDIN_CLIENT_ID={{ secrets.postiz_linkedin_client_id | default('') }}
LINKEDIN_CLIENT_SECRET={{ secrets.postiz_linkedin_client_secret | default('') }}
YOUTUBE_CLIENT_ID={{ secrets.postiz_youtube_client_id | default('') }}
YOUTUBE_CLIENT_SECRET={{ secrets.postiz_youtube_client_secret | default('') }}
DISCORD_CLIENT_ID={{ secrets.postiz_discord_client_id | default('') }}
DISCORD_CLIENT_SECRET={{ secrets.postiz_discord_client_secret | default('') }}
DISCORD_BOT_TOKEN_ID={{ secrets.postiz_discord_bot_token_id | default('') }}

# Not currently seeded — present so adding one is a seed + redeploy, not a
# code change. Renders empty until the matching key exists in OpenBao.
REDDIT_CLIENT_ID={{ secrets.postiz_reddit_client_id | default('') }}
REDDIT_CLIENT_SECRET={{ secrets.postiz_reddit_client_secret | default('') }}
GITHUB_CLIENT_ID={{ secrets.postiz_github_client_id | default('') }}
GITHUB_CLIENT_SECRET={{ secrets.postiz_github_client_secret | default('') }}
THREADS_APP_ID={{ secrets.postiz_threads_app_id | default('') }}
THREADS_APP_SECRET={{ secrets.postiz_threads_app_secret | default('') }}
FACEBOOK_APP_ID={{ secrets.postiz_facebook_app_id | default('') }}
FACEBOOK_APP_SECRET={{ secrets.postiz_facebook_app_secret | default('') }}
TIKTOK_CLIENT_ID={{ secrets.postiz_tiktok_client_id | default('') }}
TIKTOK_CLIENT_SECRET={{ secrets.postiz_tiktok_client_secret | default('') }}
PINTEREST_CLIENT_ID={{ secrets.postiz_pinterest_client_id | default('') }}
PINTEREST_CLIENT_SECRET={{ secrets.postiz_pinterest_client_secret | default('') }}
DRIBBBLE_CLIENT_ID={{ secrets.postiz_dribbble_client_id | default('') }}
DRIBBBLE_CLIENT_SECRET={{ secrets.postiz_dribbble_client_secret | default('') }}
SLACK_ID={{ secrets.postiz_slack_id | default('') }}
SLACK_SECRET={{ secrets.postiz_slack_secret | default('') }}
SLACK_SIGNING_SECRET={{ secrets.postiz_slack_signing_secret | default('') }}
MASTODON_URL={{ postiz_mastodon_url | default('https://mastodon.social') }}
MASTODON_CLIENT_ID={{ secrets.postiz_mastodon_client_id | default('') }}
MASTODON_CLIENT_SECRET={{ secrets.postiz_mastodon_client_secret | default('') }}
BEEHIIVE_API_KEY={{ secrets.postiz_beehiive_api_key | default('') }}
BEEHIIVE_PUBLICATION_ID={{ secrets.postiz_beehiive_publication_id | default('') }}
TUMBLR_CLIENT_ID={{ secrets.postiz_tumblr_client_id | default('') }}
TUMBLR_CLIENT_SECRET={{ secrets.postiz_tumblr_client_secret | default('') }}
# Listmonk is a newsletter target rather than an OAuth social provider, so it
# takes a domain + user + API key + list id instead of a client id/secret pair.
LISTMONK_DOMAIN={{ postiz_listmonk_domain | default('') }}
LISTMONK_USER={{ secrets.postiz_listmonk_user | default('') }}
LISTMONK_API_KEY={{ secrets.postiz_listmonk_api_key | default('') }}
LISTMONK_LIST_ID={{ postiz_listmonk_list_id | default('') }}

# ── Deliberately unset ──────────────────────────────────────────────────────
# OPENAI_API_KEY: no AI-generation features in scope; skynet is the eventual
#   home for any LLM call this platform makes (plan/development/06).
# STRIPE_*, FEE_AMOUNT: payment/marketplace features, not applicable to a
#   single-tenant self-host.
# NEXT_PUBLIC_POLOTNO, NEXT_PUBLIC_DISCORD_SUPPORT: upstream SaaS conveniences.
# DUB_*/SHORT_IO_*/KUTT_*/LINK_DRIP_*: third-party link shorteners, unused.
