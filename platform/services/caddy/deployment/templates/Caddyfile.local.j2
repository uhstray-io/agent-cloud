{# Local-dev Caddyfile, rendered by deploy-caddy.yml from inventory vars.
   TLS source:
     - caddy_tls_cert set -> serve the step-ca-minted wildcard leaf (a STABLE,
       shared root trusted once via `make local-tls-trust`). The cert is minted
       into ./certs by tasks/mint-internal-cert.yml and mounted at the container
       path in caddy_tls_cert/caddy_tls_key.
     - caddy_tls_cert unset -> fall back to Caddy's own internal CA (local_certs;
       ephemeral per-instance root).
   Each caddy_routes entry is {host, upstream}; the upstream is usually a
   local-dev container name (Caddy joins that network via compose.local.yml),
   but it can be any address — e.g. host.containers.internal:PORT for a service
   that runs in its own compose project (NetBox) rather than on local-dev.
   Optional {forward_auth: <outpost addr>} gates the route through Authentik's
   embedded outpost (Caddy authenticates each request and copies the
   X-authentik-* identity headers upstream) — used for services that can't do
   OIDC themselves. Optional {forward_auth_paths: [globs]} narrows that gate to
   matching paths only (e.g. gate a human /docs* UI while /v3 API traffic
   passes straight to the upstream and authenticates in-app — honcho's JWT).
   Optional {inference_api: true} renders the vLLM-security-guide edge instead
   of a plain proxy: only /v1/* (Bearer header REQUIRED — the upstream's own
   --api-key is the real check, the 401 here is defence in depth) and /health
   reach the upstream; every other path answers 404 at the edge, because vLLM
   leaves /metrics, /pause, /abort_requests, /invocations ... unauthenticated.
   Streams tokens (flush_interval -1) and caps request bodies at 16MB (a 184k-
   token prompt is ~700 KB). Same shape as the prod block in site-config's
   caddy_managed_sites; this is the locally testable copy.
   Optional {mcp_api: true} renders the same allowlist shape for the gateway's MCP
   endpoint: only the EXACT path /mcp (Bearer header required, 401 here as defence in
   depth — the gateway's own key check is the authentication) reaches the upstream;
   every other path, including /sse which the gateway also serves, /v1/*, /metrics and
   /health, answers 404 at the edge. No /health handle. inference_api and mcp_api share
   one macro (api_edge): the 401 gate, the streaming transport and the 404 fallthrough
   are one definition, so the two edges cannot drift. A route sets one flag, not both.
   Optional {upstream_tls: {server_name, client_leaf}} proxies to the upstream over mutual
   TLS (gateway task 6.2, Caddy 2.11.4): `https://`, the server verified by `server_name`
   against the internal bundle in /etc/caddy/certs, and the named client leaf presented from
   its `current/` directory (swapped by renewal, so the directory is mounted, not the files).
   Do NOT edit by hand — re-run the playbook. #}
{% set _cert = caddy_tls_cert | default('') %}
{%- macro upstream(r, tabs) -%}
{%- if r.upstream_tls is defined -%}
https://{{ r.upstream }} {
{{ tabs }}	transport http {
{{ tabs }}		tls_server_name {{ r.upstream_tls.server_name }}
{{ tabs }}		tls_trust_pool file /etc/caddy/certs/step-ca-bundle.crt
{{ tabs }}		tls_client_auth /etc/caddy/certs/{{ r.upstream_tls.client_leaf }}/current/cert.pem /etc/caddy/certs/{{ r.upstream_tls.client_leaf }}/current/key.pem
{{ tabs }}	}
{{ tabs }}}
{%- else -%}
{{ r.upstream }}
{%- endif -%}
{%- endmacro %}
{#- The allowlist edge shared by inference_api (path /v1/*, plus /health) and mcp_api
    (exact path /mcp). Emits the site body from `encode` to the closing 404 handle, WITHOUT the
    leading tab of its first line or a trailing newline: the call site supplies both. -#}
{%- macro api_edge(r, path, with_health) -%}
encode zstd gzip
	request_body {
		max_size 16MB
	}
{% if with_health %}	# Only the OpenAI-compatible API. The 401 must live INSIDE the handle block:
	# Caddy orders `handle` before a top-level `respond`, so a top-level check
	# would never run for /v1/* requests.
{% else %}	# Only the MCP endpoint, at its EXACT path. The 401 must live INSIDE the handle
	# block: Caddy orders `handle` before a top-level `respond`, so a top-level check
	# would never run for /mcp requests.
{% endif %}
	@api path {{ path }}
	handle @api {
		# header_regexp, not `header ... Bearer*`: the trailing * is a PREFIX match,
		# so `Bearer` alone or `BearerX` would pass the edge gate. Require the
		# scheme, one space, and a non-empty credential.
		@noauth not header_regexp Authorization "^Bearer [^[:space:]]+$"
		respond @noauth 401
		reverse_proxy {{ 'https://' if r.upstream_tls is defined else '' }}{{ r.upstream }} {
{% if with_health %}			# SSE token stream: flush every write; no read/write timeouts for
			# long generations.
{% else %}			# Streamable-HTTP replies may be an event stream: flush every write; no
			# read/write timeouts.
{% endif %}
			flush_interval -1
			transport http {
				dial_timeout 5s
{% if r.upstream_tls is defined %}				tls_server_name {{ r.upstream_tls.server_name }}
				tls_trust_pool file /etc/caddy/certs/step-ca-bundle.crt
				tls_client_auth /etc/caddy/certs/{{ r.upstream_tls.client_leaf }}/current/cert.pem /etc/caddy/certs/{{ r.upstream_tls.client_leaf }}/current/key.pem
{% endif %}
			}
		}
	}
{% if with_health %}	# Liveness only: 200 with an empty body, no model data.
	handle /health {
		reverse_proxy {{ upstream(r, '\t\t') }}
	}
	# Everything else, including the upstream's unauthenticated endpoints.
{% else %}	# Everything else, including /sse, which the gateway also serves.
{% endif %}
	handle {
		respond 404
	}
{%- endmacro %}
{
{% if not _cert %}	local_certs
{% endif %}	metrics
}

# Scrape listener on the private local-dev container network. The admin API
# stays loopback-only; this port is never published to the host.
http://:2021 {
	metrics /metrics
}

{% for r in caddy_routes | default([]) %}
{# A route may opt into a second, internal-only HTTPS listener (e.g. :8443) so
   in-network OIDC clients reach the IdP at the SAME host:port the browser uses
   — Caddy publishes host:8443 -> container:443, but in-network peers hit the
   container directly, so the container must also listen on :8443. The wildcard
   cert covers the host on any port; no extra host publish is needed. #}
{{ r.host }}{% if r.internal_https_port | default('') %}, {{ r.host }}:{{ r.internal_https_port }}{% endif %} {
{% if _cert %}	tls {{ _cert }} {{ caddy_tls_key }}
{% endif %}{% if r.inference_api | default(false) %}	{{ api_edge(r, '/v1/*', true) }}
{% elif r.mcp_api | default(false) %}	{{ api_edge(r, '/mcp', false) }}
{% elif r.forward_auth | default('') %}	route {
		# Strip client-supplied identity headers up front: only the outpost may
		# set them. Without this a caller could spoof X-authentik-username and
		# bypass auth (copy_headers only overwrites headers the outpost returns).
		request_header -X-authentik-username
		request_header -X-authentik-groups
		request_header -X-authentik-email
		request_header -X-authentik-name
		request_header -X-authentik-uid
		# Authentik embedded-outpost endpoints (login flow + callbacks).
		reverse_proxy /outpost.goauthentik.io/* {{ r.forward_auth }}
{% if r.forward_auth_paths | default([]) %}
		# Path-scoped gate: only these paths require an Authentik session;
		# everything else falls through to the upstream (which authenticates
		# in-app — e.g. honcho's /v3 JWT).
		@gated path {{ r.forward_auth_paths | join(' ') }}
		forward_auth @gated {{ r.forward_auth }} {
{% else %}
		# Authenticate every other request; on success the outpost returns the
		# X-authentik-* identity headers we copy to the upstream.
		forward_auth {{ r.forward_auth }} {
{% endif %}
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-authentik-username X-authentik-groups X-authentik-email X-authentik-name X-authentik-uid
			trusted_proxies private_ranges
		}
		reverse_proxy {{ upstream(r, '\t\t') }}
	}
{% else %}	reverse_proxy {{ upstream(r, '\t') }}
{% endif %}}

{% endfor %}
# Per-service fragments distributed by tasks/distribute-caddy-site.yml (none yet
# locally — the glob tolerates zero matches).
import sites/*.caddy
