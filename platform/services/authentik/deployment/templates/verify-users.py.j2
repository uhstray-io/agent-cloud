#jinja2: trim_blocks: True, lstrip_blocks: True
# Rendered by deploy-authentik.yml (post-apply VERIFY). Confirms that the blueprints
# the deploy placed were actually APPLIED, and that the accounts they declare exist
# in the state declared — present and active, or absent. Fails the deploy otherwise.
# With the console app enabled it also proves the Dispatch Console's directory token
# (CONSOLE_DIRECTORY_TOKEN) reads the directory (200) and cannot write (403) — section 5.
#
# Why this exists: blueprint application is asynchronous in the worker. A deploy
# that placed the files and saw a healthy server has proven only that the files
# landed. It has not proven that a single user was created, which is the thing an
# operator is about to hand someone a password for. Measured 2026-08-27: a deploy
# reached Phase 3 with the user blueprints assembled and NOTHING in the run able to
# say whether the accounts existed.
#
# Run inside the authentik-server container so it reads the bootstrap token from
# the container env, exactly as verify-oidc.py does:
#   <engine> exec -i authentik-server python - < verify-users.py
#
# Prints usernames, group NAMES and blueprint statuses. Never a credential.
import http.client, json, os, sys, time, urllib.parse

# Effective usernames, resolved in Phase 1 against the inventory AND the env.j2
# defaults (the same lists the create/delete collision guard compared).
EXPECT_PRESENT = {{ (_active_usernames | default([])) | to_json }}
EXPECT_ABSENT = {{ (_retired_usernames | default([])) | to_json }}
# platform-admins MEMBERSHIP. The declared administrator list plus the declared exceptions
# (platform_admins_exceptions, names only, empty by default) is the whole truth about who
# holds the admin tier: a member added by hand in the UI, or by a blueprint block outside the
# list, would hold it with no gateway identity and no record. Compared exactly, in both
# directions, and reported by account name only.
ADMIN_GROUP = "platform-admins"
EXPECT_ADMINS = {{ ((_platform_admins | default([]) | map(attribute='username') | map('string') | map('trim') | list)
                    + (_platform_admins_exceptions | default([]) | map('string') | map('trim') | list))
                   | unique | list | to_json }}
# blueprints-active/ is mounted at /blueprints/custom; every instance under that
# prefix is one this deploy is responsible for.
CUSTOM_PREFIX = "custom/"
# The files THIS deploy assembled, by name — the same expression the assemble task
# loops over, plus the rendered bindings file. Asserted against the API by exact
# path: an instance the worker never discovered has no API record at all, so
# "every instance under custom/ is successful" is silently true of a file that was
# never picked up. Measured in review, 2026-08-28.
EXPECT_BLUEPRINTS = {{ ((_shared_blueprints | default([]))
                        + ((_enabled_apps | default([])) | map('extract', authentik_app_catalog | default({}), 'file') | list)
                        + ['zz-sso-bindings.yaml', 'platform-admins.yaml']
                        + (_retired_blueprints | default([]))) | map('regex_replace', '^', 'custom/') | list | to_json }}
SETTLE_SECONDS = {{ authentik_blueprint_settle_seconds | default(120) | int }}

tok = os.environ.get("AUTHENTIK_BOOTSTRAP_TOKEN")
if not tok:
    print("VERIFY: AUTHENTIK_BOOTSTRAP_TOKEN not in the server env")
    sys.exit(3)


def get(path):
    conn = http.client.HTTPConnection("localhost", 9000, timeout=10)
    conn.request("GET", path, headers={"Authorization": "Bearer " + tok})
    resp = conn.getresponse()
    if resp.status != 200:
        print("VERIFY: %s returned %s" % (path, resp.status))
        sys.exit(3)
    return json.load(resp)


# ── 1. Every custom blueprint has settled, and settled SUCCESSFULLY ────────────
# Poll rather than assert once: the worker applies on its own schedule after a
# restart, and "unknown" a few seconds in is normal. "unknown" after the settle
# window is not.
deadline = time.time() + SETTLE_SECONDS
while True:
    instances = [b for b in get("/api/v3/managed/blueprints/?page_size=200")["results"]
                 if (b.get("path") or "").startswith(CUSTOM_PREFIX)]
    unsettled = [b["path"] for b in instances if b.get("status") in (None, "unknown")]
    if not unsettled or time.time() >= deadline:
        break
    time.sleep(5)

bad = []
if not instances:
    bad.append("no blueprint instances under %s — the assembled files were not picked up" % CUSTOM_PREFIX)
# Every file this deploy placed must have an API record — a missing one is a file
# the worker never discovered, and no amount of "successful" siblings covers it.
seen_paths = {b.get("path") for b in instances}
for p in EXPECT_BLUEPRINTS:
    if p not in seen_paths:
        bad.append("blueprint %s: placed by this deploy but the worker never discovered it (no instance)" % p)
for b in sorted(instances, key=lambda x: x.get("path") or ""):
    status = b.get("status")
    if status == "successful":
        print("OK   blueprint %-40s %s" % (b["path"], status))
    else:
        bad.append("blueprint %s: status %s (last_applied %s)" % (b["path"], status, b.get("last_applied")))

# ── 2. The accounts declared present exist and are active ─────────────────────
def find_user(username):
    q = urllib.parse.quote(username, safe="")
    # The filter's match semantics are not specified in the schema; compare exactly
    # on this side so a superstring can never satisfy a check for its prefix.
    return [u for u in get("/api/v3/core/users/?username=%s&page_size=50" % q)["results"]
            if u.get("username") == username]


for name in EXPECT_PRESENT:
    found = find_user(name)
    if len(found) != 1:
        bad.append("user %s: expected exactly 1 account, found %d" % (name, len(found)))
        continue
    u = found[0]
    if not u.get("is_active"):
        bad.append("user %s: exists but is_active is false" % name)
        continue
    groups = sorted(g.get("name", "?") for g in (u.get("groups_obj") or []))
    if not groups:
        # Present but stranded: !Find matched no group, so every access gate
        # refuses this account. It looks like a broken login and is not.
        bad.append("user %s: active but in NO groups — a !Find in the blueprint matched nothing" % name)
        continue
    print("OK   user      %-40s active, groups=%s" % (name, groups))

# ── 3. platform-admins has exactly the declared members ───────────────────────
# Read from the GROUP (direct members, users_obj), not by probing the declared names: a
# probe can only find what it already knows to look for, which is the failure this closes.
groups = [g for g in get("/api/v3/core/groups/?name=%s&include_users=true&page_size=50" % ADMIN_GROUP)["results"]
          if g.get("name") == ADMIN_GROUP]
drift = []
if len(groups) != 1:
    drift.append("group %s: expected exactly 1, found %d" % (ADMIN_GROUP, len(groups)))
else:
    members = sorted(u.get("username") for u in (groups[0].get("users_obj") or []))
    for name in sorted(set(members) - set(EXPECT_ADMINS)):
        drift.append("%s member %s: not in the declared administrator list or its exceptions" % (ADMIN_GROUP, name))
    for name in sorted(set(EXPECT_ADMINS) - set(members)):
        drift.append("%s: declared administrator %s is not a member" % (ADMIN_GROUP, name))
    if not drift:
        print("OK   group     %-40s members=%s" % (ADMIN_GROUP, members))

bad.extend(drift)

# ── 4. The accounts declared retired are gone ─────────────────────────────────
for name in EXPECT_ABSENT:
    found = find_user(name)
    if found:
        bad.append("retired user %s: still exists (%d account(s))" % (name, len(found)))
    else:
        print("OK   absent    %-40s" % name)

# ── 5. The Dispatch Console's view-only directory token (console app enabled only) ──
# The console app's blueprint (console-oidc.yaml) is in the set placed above, so once it is
# "successful" the svc-console-directory account, its group and its token exist. The token is
# read from the server env (never argv). Names and status codes only, never the token.
{% if 'console' in (_enabled_apps | default([])) %}
CONSOLE_DIRECTORY_USER = "svc-console-directory"
CONSOLE_DIRECTORY_READS = ["/api/v3/core/users/?page_size=1", "/api/v3/core/groups/?page_size=1"]
CONSOLE_WRITE_PROBE = "console-directory-write-probe"


def call(method, path, token, body=None):
    conn = http.client.HTTPConnection("localhost", 9000, timeout=10)
    headers = {"Authorization": "Bearer " + token}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    conn.request(method, path, body=data, headers=headers)
    resp = conn.getresponse()
    raw = resp.read()
    conn.close()
    return resp.status, raw


console_tok = os.environ.get("CONSOLE_DIRECTORY_TOKEN")
if not console_tok:
    bad.append("console directory token missing from the server env (CONSOLE_DIRECTORY_TOKEN)")
else:
    # The reads must be 200 with the view grant. The token is applied with its blueprint, so a
    # read a few seconds after "successful" is polled to the settle window before it fails.
    for path in CONSOLE_DIRECTORY_READS:
        read_deadline = time.time() + SETTLE_SECONDS
        status, _ = call("GET", path, console_tok)
        while status != 200 and time.time() < read_deadline:
            time.sleep(5)
            status, _ = call("GET", path, console_tok)
        resource = path.split("?")[0]
        if status == 200:
            print("OK   console directory token: GET %s -> 200" % resource)
        else:
            bad.append("console directory token: GET %s -> %s (the directory read must be 200)" % (resource, status))
    # The write must be refused. 403 is the permission check turning the POST away before it
    # validates anything. Any other status means the token reached the write path.
    status, raw = call("POST", "/api/v3/core/groups/", console_tok, {"name": CONSOLE_WRITE_PROBE})
    if status == 403:
        print("OK   console directory token: POST /api/v3/core/groups/ -> 403 (write refused)")
    else:
        bad.append("console directory token: POST /api/v3/core/groups/ -> %s (must be 403: the token is not read-only)" % status)
        if status == 201:
            # The probe created a group. Remove it with the bootstrap token, then fail regardless.
            pk = (json.loads(raw or b"{}") or {}).get("pk")
            if pk is None:
                bad.append("console directory token: the write probe created group %s but its id is unknown — remove it" % CONSOLE_WRITE_PROBE)
            else:
                dstat, _ = call("DELETE", "/api/v3/core/groups/%s/" % pk, tok)
                if dstat not in (200, 204):
                    bad.append("console directory token: the write probe created group %s and its removal returned %s — remove it" % (CONSOLE_WRITE_PROBE, dstat))

# The account itself: exactly one, not a superuser, not in platform-admins. Section 3 already
# refuses an undeclared platform-admins member; this states the rule for this account directly.
dir_found = [u for u in get("/api/v3/core/users/?username=%s&page_size=50" % CONSOLE_DIRECTORY_USER)["results"]
             if u.get("username") == CONSOLE_DIRECTORY_USER]
if len(dir_found) != 1:
    bad.append("user %s: expected exactly 1 account, found %d" % (CONSOLE_DIRECTORY_USER, len(dir_found)))
else:
    du = dir_found[0]
    dgroups = sorted(g.get("name", "?") for g in (du.get("groups_obj") or []))
    if du.get("is_superuser") is not False:
        bad.append("user %s: is_superuser is not false; the directory reader must not be a superuser" % CONSOLE_DIRECTORY_USER)
    if ADMIN_GROUP in dgroups:
        bad.append("user %s: a member of %s; the directory reader must not hold the admin tier" % (CONSOLE_DIRECTORY_USER, ADMIN_GROUP))
    print("OK   user      %-40s superuser=false, groups=%s" % (CONSOLE_DIRECTORY_USER, dgroups))
{% endif %}

if bad:
    print("VERIFY FAILED (declared state and live state disagree):")
    for line in bad:
        print("  - " + line)
    sys.exit(2)
print("VERIFY OK: %d blueprint(s) applied, %d account(s) present, %d retired"
      % (len(instances), len(EXPECT_PRESENT), len(EXPECT_ABSENT)))
