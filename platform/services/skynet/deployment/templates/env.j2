{# skynet compose env — rendered by the skynet deploy playbook from OpenBao + inventory.
   skynet's own secrets (API bearer, read bearer, database password) live at secret/services/skynet.
   The Semaphore token is secret/services/skynet:semaphore_api_token, the svc-skynet account's token
   (written by Provision skynet Semaphore Access; an existing secret, read here and never generated).
   The gateway client keys are shared reads of secret/services/agentgateway:client_<role>, merged flat
   into `secrets`. The launch-gate caller token, present only when skynet_launch_gate_url is declared, is a
   shared read of secret/services/launch-gate:caller_skynet_token. The rest is inventory. .env is gitignored
   and overwritten on every deploy.
   Do NOT edit by hand. #}
# --- compose substitution (image; the database password feeds skynet-db and skynet) ---
# Pinned by digest. Published by skynet's CI (publish-tier2.yml) to GHCR (see CLAUDE.md).
SKYNET_IMAGE={{ skynet_image }}
SKYNET_DB_PASSWORD={{ secrets.db_password }}

# --- orchestration API bearer ---
# agentgateway's /skynet route presents this as backendAuth; every route but /skynet/healthz
# answers 401 without it.
SKYNET_API_TOKEN={{ secrets.api_token }}

# --- read-only bearer (Dispatch Console) ---
# Accepted only on GET /skynet/runs and GET /skynet/runs/<id>; POST answers 401 to it. The console
# shared-reads it from secret/services/skynet:read_token (single custody: never copied elsewhere).
SKYNET_READ_TOKEN={{ secrets.read_token }}

# --- service_onboarding graph (inventory) ---
SKYNET_GATEWAY_URL={{ skynet_gateway_url }}
SKYNET_MODEL={{ skynet_model }}
SKYNET_OPA_URL={{ skynet_opa_url }}
SKYNET_SEMAPHORE_URL={{ skynet_semaphore_url }}
SKYNET_SEMAPHORE_PROJECT={{ skynet_semaphore_project }}
# svc-skynet's token (project role guest, read-only, interim since 2026-10-31): skynet's own Semaphore identity, never the operator's.
SKYNET_SEMAPHORE_TOKEN={{ secrets.semaphore_api_token }}
SKYNET_SEMAPHORE_CATALOG={{ skynet_semaphore_catalog }}
{% if (skynet_launch_gate_url | default('', true) | string | trim | length) > 0 %}

# --- launch gate (optional; skynet_launch_gate_url, every mode) ---
# skynet presents its caller token to the gate's POST /v1/launch. The token is a shared read of
# secret/services/launch-gate:caller_skynet_token (generated by the gate deploy, never here), and it is
# rendered into this file only: skynet does not write it back to OpenBao.
SKYNET_LAUNCH_GATE_URL={{ skynet_launch_gate_url }}
SKYNET_LAUNCH_GATE_TOKEN={{ secrets.caller_skynet_token }}
{% endif %}
{% if not (local_mode | default(false) | bool) and (skynet_launch_gate_url | default('', true) | string | trim | length) > 0 %}

# --- production launch-gate host mapping (compose.launch-gate.yml extra_hosts; outside local mode only) ---
# The container maps the gate's name to the address the inventory declares, as the OPA mapping below does.
SKYNET_LAUNCH_GATE_HOSTNAME={{ skynet_launch_gate_url | urlsplit('hostname') }}
SKYNET_LAUNCH_GATE_IP={{ skynet_launch_gate_ip }}
{% endif %}
{% if not (local_mode | default(false) | bool) %}

# --- production OPA host mapping (compose.prod.yml extra_hosts; outside local mode only) ---
# The OPA leaf is signed for this name, which has no production DNS record: the container maps the
# name to the declared address.
SKYNET_OPA_HOSTNAME={{ skynet_opa_url | urlsplit('hostname') }}
SKYNET_OPA_IP={{ skynet_opa_ip }}
{% endif %}

# --- host publish (substituted into compose.yml `ports:`) ---
# SKYNET_BIND, SKYNET_PORT and SKYNET_TLS_PORT must NOT be rendered here: the image sets
# SKYNET_BIND=0.0.0.0, and env_file would hand a value in this file to the container, changing its
# in-container listen address (SKYNET_TLS_PORT would move the HTTPS listener; its host port is
# SKYNET_TLS_PUBLISH_PORT below). These distinct names cannot collide with the image's variables.
SKYNET_PUBLISH_BIND={{ skynet_publish_bind | default('127.0.0.1') }}
SKYNET_PUBLISH_PORT={{ skynet_publish_port | default(8380) }}
{% if skynet_tls | default(false) | bool %}

# --- HTTPS listener (optional; skynet_tls, every mode) ---
# The image serves HTTPS on container port 8443 (its SKYNET_TLS_PORT default) once both files below
# are set; plain HTTP on 8080 is unchanged. The leaf is an internal-CA server leaf under ./certs. The
# listener checks the leaf's files on every new connection and reloads them when they changed, so a
# renewal needs no restart. compose.tls.yml publishes the port on skynet_bind:skynet_port. Those two
# names are what Renew Internal Certs reads (vars/renew-listener-servers.yml, prefix skynet) to prove
# the renewed leaf is served; skynet_bind falls back to the plain API's skynet_publish_bind here, and
# the deploy requires it declared in production because the renewal proof has no such fallback.
SKYNET_TLS_CERT_FILE=/certs/{{ skynet_server_leaf | default('skynet-server') }}/current/cert.pem
SKYNET_TLS_KEY_FILE=/certs/{{ skynet_server_leaf | default('skynet-server') }}/current/key.pem
SKYNET_TLS_PUBLISH_BIND={{ skynet_bind | default(skynet_publish_bind | default('127.0.0.1')) }}
SKYNET_TLS_PUBLISH_PORT={{ skynet_port | default(8443) }}
# The TLS name, which the leaf must carry as a SAN. compose.local.yml uses it as the local-dev network alias.
SKYNET_TLS_NAME={{ skynet_tls_server_name | default('skynet.' ~ (dns_site | default('')) ~ '.' ~ (dns_zone | default(''))) }}
{% endif %}

# --- gateway client keys (shared read, all-or-nothing) ---
# A missing OpenBao key stops the deploy: manage-secrets asserts every read_keys entry is present,
# so no .env renders without all six. A key that exists but is empty is omitted, and that role then
# fails closed. skynet never borrows another role's key.
{% if secrets['client_infra-agent'] | default('') %}
SKYNET_GATEWAY_KEY_INFRA_AGENT={{ secrets['client_infra-agent'] }}
{% endif %}
{% if secrets['client_security-agent'] | default('') %}
SKYNET_GATEWAY_KEY_SECURITY_AGENT={{ secrets['client_security-agent'] }}
{% endif %}
{% if secrets['client_o11y-agent'] | default('') %}
SKYNET_GATEWAY_KEY_O11Y_AGENT={{ secrets['client_o11y-agent'] }}
{% endif %}
{% if secrets['client_service-agent'] | default('') %}
SKYNET_GATEWAY_KEY_SERVICE_AGENT={{ secrets['client_service-agent'] }}
{% endif %}
{% if secrets['client_network-agent'] | default('') %}
SKYNET_GATEWAY_KEY_NETWORK_AGENT={{ secrets['client_network-agent'] }}
{% endif %}
{% if secrets['client_skynet-eval'] | default('') %}
SKYNET_GATEWAY_KEY_SKYNET_EVAL={{ secrets['client_skynet-eval'] }}
{% endif %}
