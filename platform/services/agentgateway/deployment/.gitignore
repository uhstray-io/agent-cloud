# Rendered per-deploy by deploy-agentgateway.yml from OpenBao + inventory. Never committed.
# .env carries the upstream key; config.yaml carries client-key HASHES and the
# identity list, and is still rendered state, not source.
.env
config.yaml
# The config a changed render replaced (rollback-inference-route.yml gateway-config mode), and
# the copy staged during a render. Hashes only, like config.yaml. Listed here also so local-dev's
# rsync --delete (tasks/place-monorepo.yml honours .gitignore) leaves them in the deploy dir.
config.yaml.previous
config.yaml.replaced
