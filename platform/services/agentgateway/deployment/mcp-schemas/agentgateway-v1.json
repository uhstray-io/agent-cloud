{
  "openapi": "3.0.3",
  "info": {
    "title": "agentgateway OpenAI-compatible API",
    "description": "The gateway's own /v1, reduced to model listing and chat completions. A tool call is a non-streaming request authenticated as the internal mcp-self identity.",
    "version": "1"
  },
  "paths": {
    "/v1/models": {
      "get": {
        "operationId": "list_models",
        "summary": "List the models this gateway serves",
        "responses": {"200": {"description": "The served models"}}
      }
    },
    "/v1/chat/completions": {
      "post": {
        "operationId": "chat_completions",
        "summary": "Send a chat completion request to a served model",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "messages"],
                "properties": {
                  "model": {"type": "string", "description": "A model name from list_models"},
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": {"type": "string", "enum": ["system", "user", "assistant"]},
                        "content": {"type": "string"}
                      }
                    }
                  },
                  "max_tokens": {"type": "integer", "minimum": 1},
                  "temperature": {"type": "number", "minimum": 0, "maximum": 2}
                }
              }
            }
          }
        },
        "responses": {"200": {"description": "The completion"}}
      }
    }
  }
}
