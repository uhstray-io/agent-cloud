{# agentgateway compose env — rendered by deploy-agentgateway.yml from OpenBao +
   inventory. The ONE secret here is the upstream credential the gateway holds
   on the team's behalf (vLLM's --api-key in prod; empty for LM Studio in
   local-dev, which has no key). config.yaml references it as $VLLM_API_KEY, so
   the rendered config carries no credential. .env is gitignored, 0600, and
   overwritten on every deploy. Do NOT edit by hand. #}
# --- compose substitution (image + published binds/ports) ---
AGW_IMAGE={{ agw_image | default('cr.agentgateway.dev/agentgateway:v1.5.0') }}
AGW_BIND={{ agw_bind | default('127.0.0.1') }}
AGW_PORT={{ agw_port | default('4000') }}
AGW_READY_BIND={{ agw_ready_bind | default('127.0.0.1') }}
AGW_READY_PORT={{ agw_ready_port | default('19001') }}
AGW_STATS_BIND={{ agw_stats_bind | default('127.0.0.1') }}
AGW_STATS_PORT={{ agw_stats_port | default('19002') }}
AGW_UI_BIND={{ agw_ui_bind | default('127.0.0.1') }}
AGW_UI_PORT={{ agw_ui_port | default('4001') }}
AGW_POSTGRES_IMAGE={{ agw_postgres_image | default('docker.io/library/postgres:16-alpine') }}

# --- the gateway's own Postgres (budget usage only; internal to the compose network) ---
# POSTGRES_* bootstrap the db container; the gateway dials AGW_DATABASE_URL,
# referenced from config.yaml as $AGW_DATABASE_URL so the rendered config holds
# no credential. Generated once by manage-secrets, reused on every deploy.
POSTGRES_DB=agentgateway
POSTGRES_USER=agentgateway
POSTGRES_PASSWORD={{ secrets.agw_db_password }}
AGW_DATABASE_URL=postgresql://agentgateway:{{ secrets.agw_db_password }}@agentgateway-db:5432/agentgateway

# --- the upstream credential (held by the gateway, never by a client) ---
# `existing` in manage-secrets: NEVER generated here. Prod seeds it from the
# dgx-spark host by a deliberate, separate playbook; empty means the upstream
# takes no key (LM Studio locally) and config.yaml omits params.apiKey.
VLLM_API_KEY={{ secrets.vllm_api_key | default('') }}

# --- operator UI OIDC (the gateway runs the login flow itself) ---
# Client secret: owned by Authentik (the IdP), shared-read here; never generated
# by this deploy. Cookie key: the gateway needs 32 bytes as 64 hex chars — derived
# deterministically from a stored random seed so sessions survive redeploys.
AGW_OIDC_CLIENT_SECRET={{ secrets.agentgateway_oidc_client_secret }}
OIDC_COOKIE_SECRET={{ secrets.agw_oidc_cookie_seed | hash('sha256') }}
