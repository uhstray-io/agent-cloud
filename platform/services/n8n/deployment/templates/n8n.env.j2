{# n8n compose env — rendered by deploy-n8n.yml from OpenBao via manage-secrets.
   Read by BOTH n8n-postgres (init creds) and n8n / n8n-worker (DB connection +
   encryption key). .env is gitignored + overwritten on every deploy.

   N8N_ENCRYPTION_KEY is STATEFUL: re-keying makes every stored workflow
   credential permanently undecryptable. manage-secrets generates it once into
   OpenBao and reuses it thereafter; for the EXISTING prod instance it must be
   pre-seeded from the live value FIRST (seed-n8n-secrets.yml / Task 0). #}
# --- container image (compose ${N8N_IMAGE} substitution; read from this .env) ---
# Local-dev overrides the base compose default (docker.n8n.io) with the Docker
# Hub mirror via the n8n_image inventory var — docker.n8n.io rate-limits
# unauthenticated pulls; docker.io/n8nio/n8n is the same image, more reliable.
N8N_IMAGE={{ n8n_image | default('docker.n8n.io/n8nio/n8n:2.25.7') }}

# --- postgres init (n8n-postgres) ---
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD={{ secrets.db_admin_password }}
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n_user
POSTGRES_NON_ROOT_PASSWORD={{ secrets.db_user_password }}

# --- n8n app DB connection (connects as the non-root n8n_user) ---
DB_POSTGRESDB_PASSWORD={{ secrets.db_user_password }}

# --- n8n encryption key (STATEFUL — never regenerate against a live instance) ---
N8N_ENCRYPTION_KEY={{ secrets.encryption_key }}

{# Community nodes: declared, not clicked (n8n >= 2.21.0; image pin is 2.25.7).
   MANAGED_BY_ENV reconciles the installed set against N8N_COMMUNITY_PACKAGES at
   every startup — installs the pinned version, uninstalls anything undeclared,
   and makes the UI's Community Nodes page read-only. Both n8n containers (app +
   worker) read this .env and share the n8n_data volume where packages land, so
   one declaration covers both. checksum = npm dist.integrity of the tarball
   (requires version). Override the set via the n8n_community_packages inventory
   var; the default pins the Postiz node per the Postiz automation contract. #}
{% set _default_community_packages = [
     {"name": "n8n-nodes-postiz",
      "version": "0.2.17",
      "checksum": "sha512-+dlEfTLuDGUsaO6aldsw3EYwyFNQmhMwEM1hrP0gSuUtPzvwblOd2kPrwKDqE6GKXZa3EnKcdYDKlBps/M1SrQ=="}
   ] %}
# --- community nodes (env-managed reconciliation; UI installs disabled) ---
N8N_COMMUNITY_PACKAGES_ENABLED=true
N8N_COMMUNITY_PACKAGES_MANAGED_BY_ENV=true
N8N_COMMUNITY_PACKAGES={{ (n8n_community_packages | default(_default_community_packages)) | to_json }}
