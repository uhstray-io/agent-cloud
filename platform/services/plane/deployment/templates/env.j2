{#-
  .env for Plane — read by Compose for substitution, and the source of every service's environment.

  Built from Plane's own variables.env for the pinned release (fetched and sha256-verified by
  deploy-plane.yml into _plane_setup_dir, never committed), with every value agent-cloud sets
  replaced. Plane ships working DEFAULT credentials in that file and in its Compose fallbacks
  (`${PI_INTERNAL_SECRET:-…}` and friends), identical on every install, so each key in
  `must_override` must come out non-empty and different from the shipped value, or rendering
  fails. Secrets come from OpenBao via manage-secrets (`secrets`). Spike 0.2 and the runtime
  results in design.md record why each key is here.
-#}
{%- set vendor_lines = lookup('file', _plane_setup_dir ~ '/variables.env').splitlines() -%}
{%- set vendor = {} -%}
{%- for line in vendor_lines if line and not line.startswith('#') and '=' in line -%}
{%-   set _ = vendor.update({line.split('=', 1)[0]: line.split('=', 1)[1]}) -%}
{%- endfor -%}
{%- set url = _plane_public_url -%}
{%- set db = secrets.plane_db_password -%}
{%- set mq = secrets.plane_rabbitmq_password -%}
{%- set minio = secrets.plane_minio_password -%}
{%- set o = {
  'COMPOSE_PROJECT_NAME': 'plane',
  'APP_RELEASE_VERSION': _plane_version,
  'DOMAIN_NAME': url | urlsplit('hostname'),
  'WEB_URL': url,
  'CORS_ALLOWED_ORIGINS': url,
  'INTEGRATION_CALLBACK_BASE_URL': url,
  'WEBHOOK_ALLOWED_HOSTS': url | urlsplit('hostname'),
  'SITE_ADDRESS': ':80',
  'TRUSTED_PROXIES': plane_trusted_proxies,
  'PLANE_BIND': plane_bind | default('127.0.0.1'),
  'PLANE_PORT': plane_port | default(8080) | string,
  'MINIO_ENDPOINT_SSL': '1' if url.startswith('https://') else '0',
  'ENABLE_SIGNUP': '0',
  'MACHINE_SIGNATURE': (secrets.plane_machine_signature | hash('sha256'))[:32],
  'SECRET_KEY': secrets.plane_secret_key,
  'LIVE_SERVER_SECRET_KEY': secrets.plane_live_server_secret_key,
  'SILO_HMAC_SECRET_KEY': secrets.plane_silo_hmac_secret_key,
  'AES_SECRET_KEY': secrets.plane_aes_secret_key,
  'PI_INTERNAL_SECRET': secrets.plane_pi_internal_secret,
  'CURSOR_WEBHOOK_SECRET': secrets.plane_cursor_webhook_secret,
  'POSTGRES_PASSWORD': db,
  'DATABASE_URL': 'postgresql://plane:' ~ db ~ '@plane-db/plane',
  'FOLLOWER_POSTGRES_URI': 'postgresql://plane:' ~ db ~ '@plane-db/plane',
  'PLANE_PI_DATABASE_URL': 'postgresql://plane:' ~ db ~ '@plane-db/plane_pi',
  'RABBITMQ_PASSWORD': mq,
  'RABBITMQ_DEFAULT_PASS': mq,
  'AMQP_URL': 'amqp://plane:' ~ mq ~ '@plane-mq:5672/plane',
  'MINIO_ROOT_PASSWORD': minio,
  'AWS_SECRET_ACCESS_KEY': minio,
} -%}
{%- set must_override = ['MACHINE_SIGNATURE', 'SECRET_KEY', 'LIVE_SERVER_SECRET_KEY', 'SILO_HMAC_SECRET_KEY',
     'AES_SECRET_KEY', 'PI_INTERNAL_SECRET', 'CURSOR_WEBHOOK_SECRET', 'POSTGRES_PASSWORD', 'DATABASE_URL',
     'FOLLOWER_POSTGRES_URI', 'PLANE_PI_DATABASE_URL', 'RABBITMQ_PASSWORD', 'RABBITMQ_DEFAULT_PASS',
     'AMQP_URL', 'MINIO_ROOT_PASSWORD', 'AWS_SECRET_ACCESS_KEY'] -%}
{%- for k in must_override if not o.get(k) or o[k] == vendor.get(k) -%}
{{ undefined_plane_override | mandatory('env.j2: ' ~ k ~ ' is empty or still Plane\'s shipped default') }}
{%- endfor -%}
# Rendered by deploy-plane.yml from Plane's variables.env ({{ _plane_version }}). Never committed.
{% for line in vendor_lines -%}
{%- set k = line.split('=', 1)[0] if ('=' in line and not line.startswith('#')) else '' -%}
{{ (k ~ '=' ~ o[k]) if k in o else line }}
{% endfor -%}
{% for k, v in o.items() if k not in vendor -%}
{{ k }}={{ v }}
{% endfor %}
