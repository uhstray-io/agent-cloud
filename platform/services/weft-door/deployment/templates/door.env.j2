{# Compose substitution for the front door — rendered by weft-door.yml for the release the host is
   pinned to, and by a person's rollback for the pin they reverted to. No secret: the signing key
   is door.key. Overwritten on every deploy. Do NOT edit by hand. #}
# The release this file was rendered for: names the next backup set, and chooses nothing.
WEFT_RELEASE={{ _weft_release_name }}
# The release's front door image, by the digest its signed release.json names.
WEFT_DOOR_IMAGE={{ _weft_images['weft-door'] }}
# The records' directory on the VM's own disk, mounted at the same path inside.
WEFT_DOOR_DIR={{ _weft_door_dir }}
# Published on the address the Caddy host reaches. Written as the host before a port, an IPv6
# address bracketed: compose.yml and deploy.sh's readiness URL put it before `:port`.
WEFT_DOOR_BIND={{ weft_door_bind | default(ansible_host) | weft_host_for_port }}
WEFT_DOOR_PORT={{ weft_door_port | default(8081) }}
# Where a workspace lives: the company name its admin chose, as a DNS label under this
# environment's domain (weft D540). The front door refuses to start on a template that puts the
# id in the address: an id address would be one the edge never routes.
WEFT_DOOR_WORKSPACE_URL=https://{name}.{{ weft_domain }}
# The client's address: the header the edge overwrites (CF-Connecting-IP: every weft name is
# proxied by Cloudflare), believed only from the edge Caddy host. tasks/weft-door-header.yml
# requires the proxies before the deploy stops anything.
WEFT_DOOR_CLIENT_ADDRESS_HEADER={{ weft_door_client_address_header | default('CF-Connecting-IP') | trim }}
WEFT_DOOR_TRUSTED_PROXIES={{ weft_door_trusted_proxies | select('string') | map('trim') | select | join(',') }}
{% if weft_door_mailpit | default(false) | bool %}
# The mail catcher (compose.mailpit.yml): deploy.sh loads the overlay only when this image is here.
# tasks/weft-door-mail.yml refuses it, before anything stops, outside staging and, on the rack, once
# any workspace is a customer's.
WEFT_DOOR_MAILPIT_IMAGE={{ _weft_mailpit_image }}
WEFT_DOOR_MAILPIT_UI_PORT={{ weft_door_mailpit_ui_port | default(8025) }}
WEFT_DOOR_MAIL_FROM={{ weft_door_mail_from | default('no-reply@' ~ weft_domain) }}
WEFT_DOOR_URL=https://{{ weft_domain }}
{% endif %}
