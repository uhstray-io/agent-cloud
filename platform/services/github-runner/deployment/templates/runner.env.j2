# runner.env — rendered by Ansible, read by deploy.sh. Gitignored on the host.
# Declaration only: nothing here is discovered at run time, so two hosts built weeks
# apart from the same inventory are the same host.
RUNNER_HOME={{ github_runner_home }}
RUNNER_NAME={{ github_runner_name }}
RUNNER_ORG_URL=https://github.com/{{ github_org }}
RUNNER_GROUP={{ github_runner_group }}
RUNNER_LABELS={{ github_runner_labels | join(',') }}

# Pinned versions. An upgrade is a change to the inventory and a review, not something
# that happens because time passed.
RUNNER_VERSION={{ github_runner_version }}
HOOKS_VERSION={{ github_runner_hooks_version }}

# Digests fetched from the release metadata for THOSE versions at deploy time, never
# hardcoded: a constant in the repo goes stale the first time a pin moves, and a
# stale-but-present digest reads as verified when it is not.
RUNNER_SHA256={{ _runner_sha256 }}
HOOKS_SHA256={{ _hooks_sha256 }}
