# /etc/github-runner/ephemeral.env: read by ephemeral-supervisor.sh. Rendered by Ansible.
# Declaration only, no credential: the just-in-time configurations are files in the
# root-only stock under RUNNER_STATE_DIR, written by stock-github-runner-jit.yml.
RUNNER_ACCOUNT={{ github_runner_account }}
RUNNER_HOME={{ github_runner_home }}
RUNNER_SEED={{ github_runner_seed }}
RUNNER_STATE_DIR={{ github_runner_state_dir }}
# GitHub removes an ephemeral runner that has not connected for a day; a configuration
# older than this is discarded rather than started.
RUNNER_JIT_MAX_AGE_MINUTES={{ github_runner_jit_max_age_minutes }}
# Runners in a row that exit without a job before the host quarantines itself.
RUNNER_MAX_START_FAILURES={{ github_runner_max_start_failures }}
