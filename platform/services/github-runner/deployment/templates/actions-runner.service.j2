[Unit]
Description=GitHub Actions self-hosted runner ({{ github_runner_name }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{ github_runner_home }}
ExecStart={{ github_runner_home }}/run.sh
{% if (github_runner_lifecycle | default('persistent')) == 'ephemeral' %}
# Ephemeral lifecycle (openspec add-ephemeral-github-runners). The unit is started by
# ephemeral-supervisor.sh for exactly one just-in-time runner, never at login, and never
# restarted by systemd: when the runner exits after its one job, the supervisor destroys the
# account's processes and files before the next runner starts. A restart here would bring a
# runner back into a home the job has used.
Restart=no
# The one runner's just-in-time configuration, written 0600 into the runtime directory by
# the supervisor (never argv, which /proc shows to every local user), read here as
# ACTIONS_RUNNER_INPUT_JITCONFIG, and removed as soon as the runner has started. The runner
# masks the value and deletes the variable from its own environment
# (Runner.Listener/CommandSettings.cs).
EnvironmentFile=-%t/actions-runner-jit.env
ExecStartPost=/bin/rm -f %t/actions-runner-jit.env
{% else %}
# The runner exits after certain updates and on some transient listener errors; always
# bring it back, or the host silently stops accepting work with nothing to show for it.
Restart=always
RestartSec=5
{% endif %}
# no_new_privs is OFF, deliberately, and must stay off. Jobs run rootless podman (a
# `container:` job through the hooks, a `podman build` in a plain step), and rootless
# podman maps the account's /etc/subuid range by running the setuid-root helpers
# newuidmap/newgidmap. The kernel accepts a uid_map of more than the writer's own id only
# from a writer with CAP_SETUID in the parent namespace (user_namespaces(7)); the helpers
# get that from their setuid bit. Under no_new_privs execve leaves setuid bits and file
# capabilities inert (prctl(2), PR_SET_NO_NEW_PRIVS), and every descendant of the runner
# inherits the bit with no way to clear it. With NoNewPrivileges=true every container job
# failed with "newuidmap: write to uid_map failed: Operation not permitted" (2026-10-11).
#
# Stated explicitly so the next hardening pass sees it was a decision. Also keep OUT of
# this unit every option that brings no_new_privs back or hides the subuid range. A user
# manager lacks CAP_SYS_ADMIN, so systemd sets no_new_privs for any seccomp-backed option:
# SystemCallFilter, SystemCallArchitectures, SystemCallLog, RestrictNamespaces,
# RestrictAddressFamilies, RestrictRealtime, RestrictSUIDSGID, LockPersonality,
# MemoryDenyWriteExecute, PrivateDevices, ProtectClock, ProtectHostname,
# ProtectKernelTunables, ProtectKernelModules, ProtectKernelLogs. And in a user unit the
# namespace and capability options (PrivateUsers, PrivateTmp, ProtectHome, the *Paths
# options, CapabilityBoundingSet and others) imply PrivateUsers, which maps only this
# account's own uid and so leaves newuidmap nothing to map.
#
# What still stands: the account has no sudoers entry (asserted at every deploy), the
# platform interior is denied at the network boundary, the workspace is wiped after every
# job, and the deploy removes the setuid bit from the helpers a runner host never needs.
# What this concedes: a job can execute the setuid programs that remain (sudo, mount,
# umount, fusermount3, newuidmap, newgidmap), so a local privilege-escalation bug in one of
# them is reachable from repository code. The deploy reads the NoNewPrivs status of the
# unit's main process, its Listener and any Worker, and fails if this ever comes back.
NoNewPrivileges=false
# How a stop reaches the runner (docs/MISTAKES.md 10.27). The main process is run.sh, which
# starts run-helper.sh, which starts bin/Runner.Listener; the Listener holds the session
# and starts a Runner.Worker per job. Neither script passes a signal on, unless
# RUNNER_MANUALLY_TRAP_SIG is set: then run.sh runs run-helper.sh as its own process group
# and turns TERM or INT into SIGINT for that group (actions/runner v2.336.0,
# src/Misc/layoutroot/run.sh, runWithManualTrap). SIGINT is the Listener's graceful stop
# (src/Runner.Listener/Runner.cs, CtrlCHandler): it stops taking jobs, cancels a running
# job through the Worker so GitHub records it as cancelled rather than lost, and deletes
# its session, so the next Listener is not refused with a session conflict. SIGTERM is not
# as good: the Listener then waits at most 30 s (Runner_Unloading, ExitOnUnloadTimeout).
# The variable is also visible to jobs; it means nothing to anything but run.sh.
#
# KillMode=mixed: the stop's SIGTERM goes to run.sh alone, and once run.sh has exited
# systemd sends SIGKILL to everything still in the unit's cgroup, including a process a
# job left running (systemd.kill(5)). Until 2026-10-12 this was KillMode=process: systemd
# signalled run.sh only, run.sh died without passing the signal on, and the Listener kept
# running in the cgroup of a stopped unit. Every restart stacked a new Listener beside the
# one that still held the session and took every job, so no change to this unit or to
# .env reached the process that runs jobs. systemd.kill(5) itself advises against
# KillMode=process for this reason. GitHub's own svc.sh template uses KillMode=process
# with runsvc.sh, whose node host sends the Listener SIGINT and then SIGKILL after 30 s
# (src/Misc/layoutbin/RunnerService.js), and leaves the rest of the cgroup running.
Environment=RUNNER_MANUALLY_TRAP_SIG=1
KillMode=mixed
KillSignal=SIGTERM
# run.sh exits 128+15 after a trapped TERM: a requested stop, not a failure.
SuccessExitStatus=143
# The bound on the graceful stop above. A Listener waits for its Worker to cancel the
# job; past this, systemd sends SIGKILL to the whole cgroup. The deploy waits for an idle
# runner before it stops one (deploy.sh quiesce), because any stop cancels a running job.
TimeoutStopSec=5min

[Install]
WantedBy=default.target
