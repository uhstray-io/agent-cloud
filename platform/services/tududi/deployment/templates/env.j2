{# tududi compose env — rendered by deploy-tududi.yml from OpenBao + inventory.
   Secrets (session secret, break-glass admin password) come from OpenBao via
   manage-secrets; the OIDC client secret is a _shared_read from authentik (the
   IdP owns it). The rest is non-secret config. .env is gitignored and
   overwritten on every deploy. Do NOT edit by hand. #}
# --- compose substitution (image + published port/bind) ---
TUDUDI_IMAGE={{ tududi_image | default('docker.io/chrisvel/tududi:latest') }}
TUDUDI_BIND={{ tududi_bind | default('127.0.0.1') }}
TUDUDI_PORT={{ tududi_port | default('3002') }}

# --- tududi runtime config (the container reads these) ---
# Serve plain HTTP on :3002 — central Caddy terminates TLS in front.
# TUDUDI_TRUST_PROXY is REQUIRED behind Caddy or SSO sessions 401.
TUDUDI_TRUST_PROXY=true
BASE_URL={{ tududi_base_url | default('https://todo.agent-cloud.test:8443') }}
TUDUDI_ALLOWED_ORIGINS={{ tududi_base_url | default('https://todo.agent-cloud.test:8443') }}
TUDUDI_SESSION_SECRET={{ secrets.tududi_session_secret }}

# --- auth: SSO-only, with a break-glass local admin ---
# PASSWORD_AUTH_ENABLED=false makes login SSO-only; the break-glass admin
# (created once from these creds) is the recovery path if OIDC is unavailable.
PASSWORD_AUTH_ENABLED=false
TUDUDI_USER_EMAIL={{ tududi_admin_email | default('admin@agent-cloud.test') }}
TUDUDI_USER_PASSWORD={{ secrets.tududi_admin_password }}

# --- OIDC (native) against Authentik ---
# The Authentik application slug, OIDC_PROVIDER_SLUG, and the callback path must
# all be "tududi" (per the tududi Authentik doc). Signing key must be RS256
# (Authentik default; tududi rejects ES256 and does not use PKCE). Callback
# registered in Authentik as a Strict redirect URI: {BASE_URL}/api/oidc/callback/tududi.
OIDC_ENABLED=true
OIDC_PROVIDER_NAME=Authentik
OIDC_PROVIDER_SLUG=tududi
OIDC_ISSUER_URL={{ tududi_oidc_issuer | default('https://auth.agent-cloud.test:8443/application/o/tududi/') }}
OIDC_CLIENT_ID=tududi
OIDC_CLIENT_SECRET={{ secrets.tududi_oidc_client_secret }}
OIDC_SCOPE=openid profile email
OIDC_AUTO_PROVISION=true
OIDC_ADMIN_EMAIL_DOMAINS={{ tududi_oidc_admin_email_domains | default('uhstray.io') }}
