# Generated by deploy-o11y.yml from the private production inventory.
{% set _o11y_local = local_mode | default(false) | bool %}
{% set _o11y_scrape_limits_ready = _o11y_local or o11y_scrape_limits_reviewed | default(false) | bool %}
{% set _o11y_scrape_limits = (o11y_scrape_limits | default({
  'body_size_limit_bytes': 16777216,
  'sample_limit': 10000,
  'label_limit': 64,
  'label_name_length_limit': 128,
  'label_value_length_limit': 2048,
} if _o11y_local else {})) if _o11y_scrape_limits_ready else {} %}
scrape_configs:
  - job_name: dgx-spark-node
    body_size_limit: {{ _o11y_scrape_limits.body_size_limit_bytes | mandatory | int }}B
    sample_limit: {{ _o11y_scrape_limits.sample_limit | mandatory | int }}
    label_limit: {{ _o11y_scrape_limits.label_limit | mandatory | int }}
    label_name_length_limit: {{ _o11y_scrape_limits.label_name_length_limit | mandatory | int }}
    label_value_length_limit: {{ _o11y_scrape_limits.label_value_length_limit | mandatory | int }}
    metric_relabel_configs:
      - action: labeldrop
        regex: {{ _o11y_forbidden_metric_label_names_regex | to_json }}
    static_configs:
{% for node in dgx_spark_nodes %}
      - targets: [{{ (node.address ~ ':' ~ (dgx_spark_node_exporter_port | string)) | to_json }}]
        labels: {service: dgx-spark, component: node-exporter, cluster: dgx-spark, environment: prod, node: {{ node.name | to_json }}}
{% endfor %}
{% if dgx_spark_gpu_exporter_enabled | default(false) | bool %}
  - job_name: dgx-spark-gpu
    body_size_limit: {{ _o11y_scrape_limits.body_size_limit_bytes | mandatory | int }}B
    sample_limit: {{ _o11y_scrape_limits.sample_limit | mandatory | int }}
    label_limit: {{ _o11y_scrape_limits.label_limit | mandatory | int }}
    label_name_length_limit: {{ _o11y_scrape_limits.label_name_length_limit | mandatory | int }}
    label_value_length_limit: {{ _o11y_scrape_limits.label_value_length_limit | mandatory | int }}
    metric_relabel_configs:
      - action: labeldrop
        regex: {{ _o11y_forbidden_metric_label_names_regex | to_json }}
    static_configs:
{% for node in dgx_spark_nodes %}
      - targets: [{{ (node.address ~ ':' ~ (dgx_spark_gpu_exporter_port | string)) | to_json }}]
        labels: {service: dgx-spark, component: gpu-exporter, cluster: dgx-spark, environment: prod, node: {{ node.name | to_json }}}
{% endfor %}
{% endif %}
  - job_name: dgx-spark-vllm
    body_size_limit: {{ _o11y_scrape_limits.body_size_limit_bytes | mandatory | int }}B
    sample_limit: {{ _o11y_scrape_limits.sample_limit | mandatory | int }}
    label_limit: {{ _o11y_scrape_limits.label_limit | mandatory | int }}
    label_name_length_limit: {{ _o11y_scrape_limits.label_name_length_limit | mandatory | int }}
    label_value_length_limit: {{ _o11y_scrape_limits.label_value_length_limit | mandatory | int }}
    metric_relabel_configs:
      - action: labeldrop
        regex: {{ _o11y_forbidden_metric_label_names_regex | to_json }}
    static_configs:
      - targets: [{{ (dgx_spark_head_address ~ ':' ~ (dgx_spark_api_port | string)) | to_json }}]
        labels: {service: vllm, component: head, cluster: dgx-spark, environment: prod, node: {{ dgx_spark_head_name | to_json }}}
