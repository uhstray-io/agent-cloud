# Grafana-managed alerts. Inventory enables them only with the OpenBao-backed
# Discord contact point; the notification drill is the rollout gate.
apiVersion: 1

groups:
  - orgId: 1
    name: service-telemetry
    folder: agent-cloud
    interval: 60s
    rules:
      - uid: o11y_service_down
        title: Service metrics endpoint down
        condition: B
        data:
          - refId: A
            relativeTimeRange: { from: 300, to: 0 }
            datasourceUid: prometheus
            model:
              editorMode: code
{% if o11y_alert_canary_service is defined %}
              expr: 'up{service="{{ o11y_alert_canary_service }}"}'
{% else %}
              expr: 'up{service!=""}'
{% endif %}
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              expression: A
              type: threshold
              conditions:
                - evaluator: { type: lt, params: [0.5] }
                  operator: { type: and }
                  query: { params: [B] }
                  reducer: { type: last, params: [] }
                  type: query
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
        noDataState: OK
        executionErrorState: Alerting
        for: 2m
        annotations:
          summary: A declared service metrics endpoint is unreachable.
          dashboard_url: '/d/service-overview?var-service={% raw %}{{ $labels.service }}{% endraw %}'
          description: Check the declared metrics target and its service onboarding receipt.
        labels:
          severity: critical
          owner: platform-operations
          environment: {{ o11y_environment | default('local' if local_mode | default(false) | bool else 'prod') | to_json }}
          cluster: {{ o11y_cluster | default('agent-cloud-local') | to_json }}
        isPaused: {{ 'false' if o11y_alerts_enabled | default(false) | bool else 'true' }}
{% if o11y_alerts_enabled | default(false) | bool %}
        notification_settings:
          receiver: agent-cloud-ops
          group_by: [service, environment, cluster, alertname]
          group_wait: 30s
          group_interval: 5m
          repeat_interval: 4h
{% endif %}
      - uid: o11y_receiver_root_disk_low
        title: Receiver host root filesystem below 10%
        condition: B
        data:
          - refId: A
            relativeTimeRange: { from: 1200, to: 0 }
            datasourceUid: prometheus
            model:
              editorMode: code
              expr: '100 * node_filesystem_avail_bytes{job="receiver-host",service="o11y/receiver-host",mountpoint="/"} / node_filesystem_size_bytes{job="receiver-host",service="o11y/receiver-host",mountpoint="/"}'
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              expression: A
              type: threshold
              conditions:
                - evaluator: { type: lt, params: [10] }
                  operator: { type: and }
                  query: { params: [B] }
                  reducer: { type: last, params: [] }
                  type: query
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
        noDataState: Alerting
        executionErrorState: Alerting
        for: 15m
        annotations:
          summary: The o11y receiver host root filesystem has less than 10% free space.
          dashboard_url: /d/o11y-self-monitoring
          description: Review guest root and named-volume backing capacity before retention or growth changes.
        labels:
          severity: warning
          service: 'o11y/receiver-host'
          owner: platform-operations
          environment: {{ o11y_environment | default('local' if local_mode | default(false) | bool else 'prod') | to_json }}
          cluster: {{ o11y_cluster | default('agent-cloud-local') | to_json }}
        isPaused: {{ 'false' if o11y_alerts_enabled | default(false) | bool and not (local_mode | default(false) | bool) and o11y_alert_canary_service is not defined else 'true' }}
{% if o11y_alerts_enabled | default(false) | bool and not (local_mode | default(false) | bool) %}
        notification_settings:
          receiver: agent-cloud-ops
          group_by: [service, environment, cluster, alertname]
          group_wait: 30s
          group_interval: 5m
          repeat_interval: 4h
{% endif %}
{# The local inventory generated before this rollout still needs the Caddy pilot
   contract; a declared inventory list overrides this default. #}
{% for target in o11y_expected_metrics_targets | default([{'uid': 'o11y_missing_caddy', 'service': 'caddy-reverse-proxy/caddy', 'instance': 'caddy:2021'}] if local_mode | default(false) | bool else []) %}
      - uid: {{ target.uid }}
        title: Missing telemetry for {{ target.service }} at {{ target.instance }}
        condition: B
        data:
          - refId: A
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: prometheus
            model:
              editorMode: code
              expr: 'absent_over_time(up{service="{{ target.service }}",instance="{{ target.instance }}"}[5m])'
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              expression: A
              type: threshold
              conditions:
                - evaluator: { type: gt, params: [0.5] }
                  operator: { type: and }
                  query: { params: [B] }
                  reducer: { type: last, params: [] }
                  type: query
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
        noDataState: OK
        executionErrorState: Alerting
        for: 2m
        annotations:
          summary: Expected metrics have disappeared for {{ target.service }}.
          dashboard_url: /d/service-overview?var-service={{ target.service }}
          description: Check the declared metrics target and its service onboarding receipt.
        labels:
          severity: critical
          service: '{{ target.service }}'
          owner: platform-operations
          environment: {{ o11y_environment | default('local' if local_mode | default(false) | bool else 'prod') | to_json }}
          cluster: {{ o11y_cluster | default('agent-cloud-local') | to_json }}
        isPaused: {{ 'false' if o11y_alerts_enabled | default(false) | bool and o11y_alert_canary_service is not defined else 'true' }}
{% if o11y_alerts_enabled | default(false) | bool and o11y_alert_canary_service is not defined %}
        notification_settings:
          receiver: agent-cloud-ops
          group_by: [service, environment, cluster, alertname]
          group_wait: 30s
          group_interval: 5m
          repeat_interval: 4h
{% endif %}
{% endfor %}
