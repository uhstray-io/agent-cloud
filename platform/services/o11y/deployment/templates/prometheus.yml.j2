# Prometheus scrape config (committed config-as-code). Mounted read-only.
# Plan: plan/development/O11Y-DEPLOYMENT.md. Targets are reached by container
# name on the shared network (Caddy joins it via compose.local.yml locally).
{% set _o11y_local = local_mode | default(false) | bool %}
{% set _o11y_scrape_limits_ready = _o11y_local or o11y_scrape_limits_reviewed | default(false) | bool %}
{% set _o11y_scrape_limits = (o11y_scrape_limits | default({
  'body_size_limit_bytes': 16777216,
  'sample_limit': 10000,
  'label_limit': 64,
  'label_name_length_limit': 128,
  'label_value_length_limit': 2048,
} if _o11y_local else {})) if _o11y_scrape_limits_ready else {} %}
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: {{ o11y_cluster | default('agent-cloud-local') | to_json }}
    environment: {{ o11y_environment | default('local' if local_mode | default(false) | bool else 'prod') | to_json }}

scrape_config_files:
  - /etc/prometheus/scrape.d/*.yml

scrape_configs:
  - job_name: prometheus
    body_size_limit: {{ _o11y_scrape_limits.body_size_limit_bytes | mandatory | int }}B
    sample_limit: {{ _o11y_scrape_limits.sample_limit | mandatory | int }}
    label_limit: {{ _o11y_scrape_limits.label_limit | mandatory | int }}
    label_name_length_limit: {{ _o11y_scrape_limits.label_name_length_limit | mandatory | int }}
    label_value_length_limit: {{ _o11y_scrape_limits.label_value_length_limit | mandatory | int }}
    metric_relabel_configs:
      - action: labeldrop
        regex: {{ _o11y_forbidden_metric_label_names_regex | to_json }}
    static_configs:
      - targets: ["localhost:9090"]
        labels:
          service: o11y/prometheus
          cluster: {{ o11y_cluster | default('agent-cloud-local') | to_json }}
          environment: {{ o11y_environment | default('local' if local_mode | default(false) | bool else 'prod') | to_json }}

  # Receiver-host capacity metrics stay private to the o11y Compose network.
  # The dedicated exporter is not published on a host port and exposes only
  # its bounded CPU, memory, root filesystem, and load-average collectors.
  - job_name: receiver-host
    body_size_limit: {{ _o11y_scrape_limits.body_size_limit_bytes | mandatory | int }}B
    sample_limit: {{ [o11y_scrape_sample_limit | default(2000) | int, _o11y_scrape_limits.sample_limit | mandatory | int] | min }}
    label_limit: {{ _o11y_scrape_limits.label_limit | mandatory | int }}
    label_name_length_limit: {{ _o11y_scrape_limits.label_name_length_limit | mandatory | int }}
    label_value_length_limit: {{ _o11y_scrape_limits.label_value_length_limit | mandatory | int }}
    metric_relabel_configs:
      - action: labeldrop
        regex: {{ _o11y_forbidden_metric_label_names_regex | to_json }}
      - action: labeldrop
        regex: '^device$'
    static_configs:
      - targets: ["node-exporter:9100"]
        labels:
          service: o11y/receiver-host
          cluster: {{ o11y_cluster | default('agent-cloud-local') | to_json }}
          environment: {{ o11y_environment | default('local' if local_mode | default(false) | bool else 'prod') | to_json }}

  # Self-monitoring stays on the private o11y network; no extra host ports.
  - job_name: grafana
    body_size_limit: {{ _o11y_scrape_limits.body_size_limit_bytes | mandatory | int }}B
    sample_limit: {{ _o11y_scrape_limits.sample_limit | mandatory | int }}
    label_limit: {{ _o11y_scrape_limits.label_limit | mandatory | int }}
    label_name_length_limit: {{ _o11y_scrape_limits.label_name_length_limit | mandatory | int }}
    label_value_length_limit: {{ _o11y_scrape_limits.label_value_length_limit | mandatory | int }}
    metric_relabel_configs:
      - action: labeldrop
        regex: {{ _o11y_forbidden_metric_label_names_regex | to_json }}
    static_configs:
      - targets: ["grafana:3000"]
        labels:
          service: o11y/grafana
          cluster: {{ o11y_cluster | default('agent-cloud-local') | to_json }}
          environment: {{ o11y_environment | default('local' if local_mode | default(false) | bool else 'prod') | to_json }}

  - job_name: loki
    body_size_limit: {{ _o11y_scrape_limits.body_size_limit_bytes | mandatory | int }}B
    sample_limit: {{ _o11y_scrape_limits.sample_limit | mandatory | int }}
    label_limit: {{ _o11y_scrape_limits.label_limit | mandatory | int }}
    label_name_length_limit: {{ _o11y_scrape_limits.label_name_length_limit | mandatory | int }}
    label_value_length_limit: {{ _o11y_scrape_limits.label_value_length_limit | mandatory | int }}
    metric_relabel_configs:
      - action: labeldrop
        regex: {{ _o11y_forbidden_metric_label_names_regex | to_json }}
    static_configs:
      - targets: ["loki:3100"]
        labels:
          service: o11y/loki
          cluster: {{ o11y_cluster | default('agent-cloud-local') | to_json }}
          environment: {{ o11y_environment | default('local' if local_mode | default(false) | bool else 'prod') | to_json }}

  - job_name: alloy
    body_size_limit: {{ _o11y_scrape_limits.body_size_limit_bytes | mandatory | int }}B
    sample_limit: {{ _o11y_scrape_limits.sample_limit | mandatory | int }}
    label_limit: {{ _o11y_scrape_limits.label_limit | mandatory | int }}
    label_name_length_limit: {{ _o11y_scrape_limits.label_name_length_limit | mandatory | int }}
    label_value_length_limit: {{ _o11y_scrape_limits.label_value_length_limit | mandatory | int }}
    metric_relabel_configs:
      - action: labeldrop
        regex: {{ _o11y_forbidden_metric_label_names_regex | to_json }}
    static_configs:
      - targets: ["alloy:12345"]
        labels:
          service: o11y/alloy
          cluster: {{ o11y_cluster | default('agent-cloud-local') | to_json }}
          environment: {{ o11y_environment | default('local' if local_mode | default(false) | bool else 'prod') | to_json }}

  - job_name: tempo
    body_size_limit: {{ _o11y_scrape_limits.body_size_limit_bytes | mandatory | int }}B
    sample_limit: {{ _o11y_scrape_limits.sample_limit | mandatory | int }}
    label_limit: {{ _o11y_scrape_limits.label_limit | mandatory | int }}
    label_name_length_limit: {{ _o11y_scrape_limits.label_name_length_limit | mandatory | int }}
    label_value_length_limit: {{ _o11y_scrape_limits.label_value_length_limit | mandatory | int }}
    metric_relabel_configs:
      - action: labeldrop
        regex: {{ _o11y_forbidden_metric_label_names_regex | to_json }}
    static_configs:
      - targets: ["tempo:3200"]
        labels:
          service: o11y/tempo
          cluster: {{ o11y_cluster | default('agent-cloud-local') | to_json }}
          environment: {{ o11y_environment | default('local' if local_mode | default(false) | bool else 'prod') | to_json }}

  - job_name: pyroscope
    body_size_limit: {{ _o11y_scrape_limits.body_size_limit_bytes | mandatory | int }}B
    sample_limit: {{ _o11y_scrape_limits.sample_limit | mandatory | int }}
    label_limit: {{ _o11y_scrape_limits.label_limit | mandatory | int }}
    label_name_length_limit: {{ _o11y_scrape_limits.label_name_length_limit | mandatory | int }}
    label_value_length_limit: {{ _o11y_scrape_limits.label_value_length_limit | mandatory | int }}
    metric_relabel_configs:
      - action: labeldrop
        regex: {{ _o11y_forbidden_metric_label_names_regex | to_json }}
    static_configs:
      - targets: ["pyroscope:4040"]
        labels:
          service: o11y/pyroscope
          cluster: {{ o11y_cluster | default('agent-cloud-local') | to_json }}
          environment: {{ o11y_environment | default('local' if local_mode | default(false) | bool else 'prod') | to_json }}

  # Phase 2 (O11Y-DEPLOYMENT.md) — per-target metrics:
  #   - Caddy: its admin API (:2019/metrics) binds LOOPBACK-ONLY, so it is not
  #     scrapeable cross-container. Phase 2 adds a dedicated routable metrics
  #     listener in the Caddyfile (e.g. `:2021 { metrics }`) and scrapes that.
  #     (The `metrics` global option is already enabled in Caddyfile.local.j2.)
  #   - Containers/host: cAdvisor + node-exporter once validated on the VM.
  #   - Agents: the orb-agent OTLP path via Alloy.
  # Each also needs a Prometheus reload (--web.enable-lifecycle / POST /-/reload)
  # wired into the deploy when scrape targets change.
