# Generated by instrument-host-o11y.yml from the private inventory: the host exporters of one
# service group (workflow step instrument-host). The same bounded collectors as receiver-host.
{% set _o11y_local = local_mode | default(false) | bool %}
{% set _o11y_scrape_limits_ready = _o11y_local or o11y_scrape_limits_reviewed | default(false) | bool %}
{% set _o11y_scrape_limits = (o11y_scrape_limits | default({
  'body_size_limit_bytes': 16777216,
  'sample_limit': 10000,
  'label_limit': 64,
  'label_name_length_limit': 128,
  'label_value_length_limit': 2048,
} if _o11y_local else {})) if _o11y_scrape_limits_ready else {} %}
scrape_configs:
  - job_name: {{ _ih_job | to_json }}
    honor_labels: false
    body_size_limit: {{ _o11y_scrape_limits.body_size_limit_bytes | mandatory | int }}B
    sample_limit: {{ [o11y_scrape_sample_limit | default(2000) | int, _o11y_scrape_limits.sample_limit | mandatory | int] | min }}
    label_limit: {{ _o11y_scrape_limits.label_limit | mandatory | int }}
    label_name_length_limit: {{ _o11y_scrape_limits.label_name_length_limit | mandatory | int }}
    label_value_length_limit: {{ _o11y_scrape_limits.label_value_length_limit | mandatory | int }}
    metric_relabel_configs:
      - action: labeldrop
        regex: {{ _o11y_forbidden_metric_label_names_regex | to_json }}
      - action: labeldrop
        regex: '^device$'
    static_configs:
{% for target in _ih_endpoints %}
      - targets: [{{ target.address | to_json }}]
        labels:
          service: {{ target.service | to_json }}
          component: node-exporter
          host: {{ target.host | to_json }}
          cluster: {{ o11y_cluster | default('agent-cloud-local') | to_json }}
          environment: {{ o11y_environment | default('local' if local_mode | default(false) | bool else 'prod') | to_json }}
{% if target.identity_bound | default(false) %}
          target_id: {{ target.target_id | to_json }}
          metrics_scope: host
{% endif %}
{% endfor %}
