# Generated by deploy-o11y.yml only when private inventory declares a reachable stats endpoint.
scrape_configs:
  - job_name: agentgateway
    metrics_path: /metrics
    metric_relabel_configs:
      - action: labeldrop
        regex: {{ _o11y_forbidden_metric_label_names_regex | to_json }}
    static_configs:
      - targets: [{{ (agentgateway_metrics_address ~ ':' ~ (agentgateway_metrics_port | string)) | to_json }}]
        labels:
          service: agentgateway
          component: gateway
          cluster: {{ o11y_cluster | default('agent-cloud-local') | to_json }}
          environment: {{ o11y_environment | default('local' if local_mode | default(false) | bool else 'prod') | to_json }}
