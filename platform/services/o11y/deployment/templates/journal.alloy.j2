// Reads the user-journal entries of each container in the declared receiver cohort
// (o11y_journal_components) and sends them over the receiver's existing private
// OTLP/gRPC listener.
{% for c in o11y_journal_components %}
loki.source.journal "{{ c.component }}" {
  path       = "/var/log/journal"
  matches    = "CONTAINER_NAME={{ c.container }}"
  max_age    = "15m"
  labels     = { service = "{{ c.service }}", signal = "container", target_id = "service:o11y" }
  forward_to = [otelcol.receiver.loki.journal.receiver]
}

{% endfor %}
otelcol.receiver.loki "journal" {
  output {
    logs = [otelcol.processor.attributes.journal_labels.input]
  }
}

otelcol.processor.attributes "journal_labels" {
  action {
    key    = "loki.attribute.labels"
    action = "upsert"
    value  = "service,signal,target_id"
  }
  output {
    logs = [otelcol.exporter.otlp.journal.input]
  }
}

otelcol.exporter.otlp "journal" {
  client {
    endpoint = {{ (o11y_otlp_bind ~ ':' ~ (o11y_otlp_port | default(4317) | string)) | to_json }}
{% if o11y_otlp_tls_enabled | default(false) | bool %}
    tls {
      ca_file = "/certs/step-ca-bundle.crt"
      cert_file = "/certs/journal-client/current/cert.pem"
      key_file = "/certs/journal-client/current/key.pem"
      server_name = {{ o11y_otlp_tls_server_name | to_json }}
      reload_interval = "1m"
    }
{% else %}
    tls {
      insecure = true
    }
{% endif %}
  }
  retry_on_failure {
    enabled = true
  }
  sending_queue {
    enabled = true
    queue_size = 100
  }
}
