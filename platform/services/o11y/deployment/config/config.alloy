// Grafana Alloy config (River) — committed config-as-code. Plan: O11Y-DEPLOYMENT.md.
//
// Phase 0/1: discover local containers over the mounted engine socket and ship
// their stdout/stderr to Loki. The socket is mounted at /var/run/docker.sock by
// compose.local.yml (the podman API is docker-API-compatible).
//
// Phase 2 (O11Y-DEPLOYMENT.md): add `otelcol.receiver.otlp` (with real metric/
// log/trace consumers) for orb-agent telemetry, and tail the OpenBao audit log.
// It is omitted here on purpose — an OTLP receiver with no output errors at boot.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Relabel: expose the container name as a `container` label on every line.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }

  // Keep the historical container label for existing dashboards while adding
  // the canonical service identity used by metrics and future traces.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "service"
  }
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = {
    cluster = "agent-cloud-local",
  }
}

// Reuse Alloy's socket discovery for opted-in metrics. Prometheus has no socket.
discovery.relabel "metrics" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_prometheus_io_scrape"]
    action        = "keep"
    regex         = "true"
  }

  rule {
    source_labels = ["__meta_docker_container_label_prometheus_io_port"]
    action        = "keep"
    regex         = "[0-9]+"
  }

  rule {
    source_labels = ["__meta_docker_container_label_prometheus_io_high_churn"]
    action        = "drop"
    regex         = "true"
  }

  rule {
    source_labels = ["__meta_docker_container_name", "__meta_docker_container_label_prometheus_io_port"]
    regex         = "/?(.+);([0-9]+)"
    replacement   = "$1:$2"
    target_label  = "__address__"
  }

  rule {
    source_labels = ["__meta_docker_container_label_prometheus_io_path"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "component"
  }
}

prometheus.scrape "local_containers" {
  targets         = discovery.relabel.metrics.output
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
