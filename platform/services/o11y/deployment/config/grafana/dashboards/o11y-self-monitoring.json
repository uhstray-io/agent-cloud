{
  "annotations": { "list": [] },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "O11y components up (expected 4)",
      "type": "stat",
      "description": "Prometheus, Grafana, Loki, and Alloy self scrapes. A missing target lowers the count.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "min": 0, "max": 4, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 3 }, { "color": "green", "value": 4 }] } }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(up{job=~\"prometheus|grafana|loki|alloy\"})", "instant": true }]
    },
    {
      "id": 2,
      "title": "Active Prometheus series",
      "type": "stat",
      "description": "Current head series count; growth indicates increasing metrics volume and cardinality.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "prometheus_tsdb_head_series{job=\"prometheus\"}", "instant": true }]
    },
    {
      "id": 3,
      "title": "Loki log bytes / sec",
      "type": "stat",
      "description": "Incoming log payload rate; zero is expected until a sender is enabled.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(loki_distributor_bytes_received_total{job=\"loki\"}[5m])) or vector(0)", "instant": true }]
    },
    {
      "id": 4,
      "title": "Component scrape status",
      "type": "timeseries",
      "description": "Each o11y process must remain at 1. Gaps indicate missing samples; zero indicates a failed scrape.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "up{job=~\"prometheus|grafana|loki|alloy\"}", "legendFormat": "{{job}}" }]
    },
    {
      "id": 5,
      "title": "Samples per scrape",
      "type": "timeseries",
      "description": "How many metrics each o11y component exposes on every Prometheus scrape.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "scrape_samples_scraped{job=~\"prometheus|grafana|loki|alloy\"}", "legendFormat": "{{job}}" }]
    },
    {
      "id": 6,
      "title": "Loki log lines / sec",
      "type": "timeseries",
      "description": "Incoming log line rate from all senders; use alongside log bytes to spot surges.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(loki_distributor_lines_received_total{job=\"loki\"}[5m])) or vector(0)" }]
    },
    {
      "id": 7,
      "title": "Alloy component health",
      "type": "timeseries",
      "description": "Running Alloy components by health class; unhealthy components expose collector failures beyond process liveness.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "alloy_component_controller_running_components{job=\"alloy\"}", "legendFormat": "{{health_type}}" }]
    },
    {
      "id": 8,
      "title": "O11y process memory",
      "type": "timeseries",
      "description": "Resident memory for all four o11y processes; compare trends with data volume.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "process_resident_memory_bytes{job=~\"prometheus|grafana|loki|alloy\"}", "legendFormat": "{{job}}" }]
    }
  ],
  "schemaVersion": 39,
  "tags": ["agent-cloud", "o11y", "self-monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "Observability estate health",
  "uid": "o11y-self-monitoring",
  "version": 1
}
