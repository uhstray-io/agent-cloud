{
  "uid": "inference-fleet-health",
  "title": "Inference fleet health",
  "description": "Scrape health, memory headroom against the memory guard thresholds, host load and journal lines for the DGX Spark pair.",
  "tags": [
    "agent-cloud",
    "inference",
    "dgx-spark"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "dgx-spark benchmark results",
      "type": "link",
      "url": "https://github.com/uhstray-io/dgx-spark/tree/main/results",
      "targetBlank": true,
      "icon": "doc",
      "tooltip": "Benchmark run manifests (placement, profile, image) in the dgx-spark repository"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "model_alias",
        "label": "Model alias",
        "description": "vLLM labels its series with model_name, which carries the served model name (the alias dgx-spark ships as model_alias on Loki streams).",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(vllm:num_requests_running{job=\"dgx-spark-vllm\", cluster=\"dgx-spark\"}, model_name)",
        "query": {
          "query": "label_values(vllm:num_requests_running{job=\"dgx-spark-vllm\", cluster=\"dgx-spark\"}, model_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Node exporter up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"dgx-spark-node\", cluster=\"dgx-spark\"}",
          "legendFormat": "{{node}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "vLLM metrics up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"dgx-spark-vllm\", cluster=\"dgx-spark\"}",
          "legendFormat": "{{node}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Node uptime",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - node_boot_time_seconds{job=\"dgx-spark-node\", cluster=\"dgx-spark\"}",
          "legendFormat": "{{node}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Requests waiting",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model_name) (vllm:num_requests_waiting{job=\"dgx-spark-vllm\", cluster=\"dgx-spark\", model_name=~\"$model_alias\"})",
          "legendFormat": "{{model_name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Available memory (guard stall line 512 MiB)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "description": "The memory guard kills the serving container after 120 s of MemAvailable below 512 MiB (dgx-spark vllm/mem-guard.sh).",
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{job=\"dgx-spark-node\", cluster=\"dgx-spark\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 536870912
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Free memory (guard floor 1 GiB)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "description": "The memory guard kills the serving container after 4 s of MemFree below the floor, 1 GiB by default (dgx-spark group_vars vllm_mem_floor_gib).",
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemFree_bytes{job=\"dgx-spark-node\", cluster=\"dgx-spark\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1073741824
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "CPU busy fraction",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg by (node) (rate(node_cpu_seconds_total{job=\"dgx-spark-node\", cluster=\"dgx-spark\", mode=\"idle\"}[5m]))",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Load average (1 min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{job=\"dgx-spark-node\", cluster=\"dgx-spark\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Root filesystem free",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{job=\"dgx-spark-node\", cluster=\"dgx-spark\", mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"dgx-spark-node\", cluster=\"dgx-spark\", mountpoint=\"/\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Running requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model_name) (vllm:num_requests_running{job=\"dgx-spark-vllm\", cluster=\"dgx-spark\", model_name=~\"$model_alias\"})",
          "legendFormat": "{{model_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Memory guard strikes and kills",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "description": "Journal lines from the memory guard, shipped with the vLLM unit labels.",
      "targets": [
        {
          "refId": "A",
          "expr": "{cluster=\"dgx-spark\", service=\"vllm\"} |~ \"LOW MEMORY|KILLING|MemAvailable ~0\""
        }
      ]
    },
    {
      "id": 12,
      "title": "Recent vLLM journal",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{cluster=\"dgx-spark\", service=\"vllm\"}"
        }
      ]
    }
  ]
}
