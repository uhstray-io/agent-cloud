{
  "annotations": {
    "list": []
  },
  "editable": false,
  "description": "Metrics panels use the Metrics service selector from Prometheus; Loki panels use the Logs service selector from Loki. Each Loki source has its own panel. A service missing from one selector has no observed data in that source, not a healthy zero.",
  "panels": [
    {
      "title": "Scrape target health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "description": "Minimum up value across the selected Metrics service scrape targets. 0 means at least one target is down; 1 means all reported targets are up. No metrics means no scrape data.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No metrics",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (service) (up{service=~\"$service\"})",
          "instant": true
        }
      ]
    },
    {
      "title": "Current scrape targets",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "description": "Count of currently reported scrape targets for the selected Metrics service, including targets with up=0. This measures target visibility, not service health. No targets means no current scrape telemetry, not a healthy zero.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No targets",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (service) (up{service=~\"$service\"})",
          "instant": true
        }
      ]
    },
    {
      "title": "Scrape availability over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "description": "At each point in the selected time range, the percentage of reported scrape targets for the selected Metrics service that are up. Failed scrapes count as 0%; missing telemetry produces gaps or no data, not a healthy zero.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (service) (up{service=~\"$service\"}) * 100",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "Unhealthy scrape targets",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "description": "Currently failed targets for the selected Metrics service, with their service, job, and instance labels. No rows means no reported failures; the health stat shows No metrics when no targets report.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{service=~\"$service\"} == 0",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "title": "Log volume by source",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "description": "Loki log lines per second for the selected Logs service, separated into disjoint legacy container, journal container, gateway access, optional gateway span, and workflow conformance sources. Missing data means no matching logs were observed and does not indicate service health; Prometheus scrape health is shown separately above.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate({service=~\"$log_service\", container=~\".+\", signal!~\"^(container|access-log|span)$\", job!=\"agent-cloud-conformance\"}[5m]))",
          "legendFormat": "Legacy container · {{service}}"
        },
        {
          "refId": "E",
          "expr": "sum by (service) (rate({service=~\"$log_service\", signal=\"container\", job!=\"agent-cloud-conformance\"}[5m]))",
          "legendFormat": "Journal container · {{service}}"
        },
        {
          "refId": "B",
          "expr": "sum by (service) (rate({service=~\"$log_service\", signal=\"access-log\", job!=\"agent-cloud-conformance\"}[5m]))",
          "legendFormat": "Access · {{service}}"
        },
        {
          "refId": "C",
          "expr": "sum by (service) (rate({service=~\"$log_service\", signal=\"span\", job!=\"agent-cloud-conformance\"}[5m]))",
          "legendFormat": "Span · {{service}}"
        },
        {
          "refId": "D",
          "expr": "sum by (service) (rate({service=~\"$log_service\", job=\"agent-cloud-conformance\"}[5m]))",
          "legendFormat": "Conformance · {{service}}"
        }
      ]
    },
    {
      "title": "Recent container logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "description": "For the selected Logs service, includes journal records marked signal=\"container\" even when they also have a container label, plus legacy container records whose signal is outside container/access-log/span. This is container output, not service health.",
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$log_service\", job!=\"agent-cloud-conformance\"} | (signal=\"container\" or (container=~\".+\" and signal!~\"^(container|access-log|span)$\"))",
          "maxLines": 100
        }
      ]
    },
    {
      "title": "Recent gateway access records",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "description": "OTLP gateway access records for the selected Logs service. These structured records are separate from container output and optional span logs.",
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$log_service\", signal=\"access-log\", job!=\"agent-cloud-conformance\"}",
          "maxLines": 100
        }
      ]
    },
    {
      "title": "Recent optional span logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "description": "Derived span log lines for the selected Logs service. This stream is inventory-gated and may be absent; Tempo remains the trace store.",
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$log_service\", signal=\"span\", job!=\"agent-cloud-conformance\"}",
          "maxLines": 100
        }
      ]
    },
    {
      "title": "Recent workflow conformance records",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "description": "Service workflow status records for the selected Logs service. These are collector snapshots, not application logs.",
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$log_service\", job=\"agent-cloud-conformance\"}",
          "maxLines": 100
        }
      ]
    },
    {
      "title": "All Loki streams (mixed-source drill-down)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "description": "Bounded mixed-source drill-down for every Loki stream carrying the selected Logs service, including streams not yet classified in a source-specific panel. Prefer the source-specific panels above for routine review; mixed logs do not indicate service health.",
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$log_service\"}",
          "maxLines": 100
        }
      ]
    },
    {
      "title": "Selected service identities",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "description": "Metrics and logs are selected independently; their service identities are shown here.",
      "options": {
        "mode": "markdown",
        "content": "**Metrics service:** $service  \n**Logs service:** $log_service"
      }
    },
    {
      "title": "Selected source records observed (5m)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "description": "For the selected Logs service, each source reports whether matching records were observed in five minutes. “No records” is a neutral absence observation, not a zero-health result or an ingestion diagnosis. Query errors remain errors.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No records",
                  "color": "gray",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1e-06,
                "to": 1e+18,
                "result": {
                  "text": "Records observed",
                  "color": "blue",
                  "index": 0
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "No query result"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "(sum(count_over_time({service=~\"$log_service\", container=~\".+\", signal!~\"^(container|access-log|span)$\", job!=\"agent-cloud-conformance\"}[5m])) or on() vector(0))",
          "legendFormat": "Legacy container"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "(sum(count_over_time({service=~\"$log_service\", signal=\"container\", job!=\"agent-cloud-conformance\"}[5m])) or on() vector(0))",
          "legendFormat": "Journal container"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "(sum(count_over_time({service=~\"$log_service\", signal=\"access-log\", job!=\"agent-cloud-conformance\"}[5m])) or on() vector(0))",
          "legendFormat": "Access"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "(sum(count_over_time({service=~\"$log_service\", signal=\"span\", job!=\"agent-cloud-conformance\"}[5m])) or on() vector(0))",
          "legendFormat": "Span"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "(sum(count_over_time({service=~\"$log_service\", job=\"agent-cloud-conformance\"}[5m])) or on() vector(0))",
          "legendFormat": "Conformance"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "agent-cloud",
    "observability"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Metrics service",
        "type": "query",
        "current": {
          "text": "agentgateway",
          "value": "agentgateway"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up, service)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "description": "Values currently exposed by Prometheus. Services with logs only are available under Logs service."
      },
      {
        "name": "log_service",
        "label": "Logs service",
        "type": "query",
        "current": {
          "text": "agentgateway",
          "value": "agentgateway"
        },
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({service=~\".+\"}, service)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "description": "Values currently exposed by Loki. This includes services with logs but no Prometheus metrics."
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Service Overview",
  "uid": "service-overview",
  "version": 1
}
