{
  "uid": "agentgateway-traffic",
  "title": "Agentgateway operations",
  "tags": ["agent-cloud", "agentgateway", "inference"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "identity",
        "label": "Identity",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(agentgateway_requests_total{job=\"agentgateway\"}, identity)",
        "query": {"query": "label_values(agentgateway_requests_total{job=\"agentgateway\"}, identity)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Gateway scrape up",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "up{job=\"agentgateway\"}", "instant": true}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 2,
      "title": "Configuration synchronized",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 0},
      "targets": [{"refId": "A", "expr": "agentgateway_config_synchronized{job=\"agentgateway\"}", "instant": true}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 3,
      "title": "Requests per second",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(agentgateway_requests_total{job=\"agentgateway\", identity=~\"$identity\"}[5m]))", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"colorMode": "none"}
    },
    {
      "id": 4,
      "title": "Requests by HTTP status",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(agentgateway_requests_total{job=\"agentgateway\", identity=~\"$identity\"}[5m]))", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 5,
      "title": "Server error ratio",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [{"refId": "A", "expr": "sum(rate(agentgateway_requests_total{job=\"agentgateway\",status=~\"5..\", identity=~\"$identity\"}[5m])) / clamp_min(sum(rate(agentgateway_requests_total{job=\"agentgateway\", identity=~\"$identity\"}[5m])), 1e-9)"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 6,
      "title": "Request latency p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(agentgateway_request_duration_seconds_bucket{job=\"agentgateway\", identity=~\"$identity\"}[5m])))"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 7,
      "title": "LLM tokens per second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "targets": [{"refId": "A", "expr": "sum by (gen_ai_token_type, gen_ai_request_model) (rate(agentgateway_gen_ai_client_token_usage_sum{job=\"agentgateway\", identity=~\"$identity\"}[5m]))", "legendFormat": "{{gen_ai_token_type}} · {{gen_ai_request_model}}"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 8,
      "title": "Time to first token p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 21},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(agentgateway_gen_ai_server_time_to_first_token_bucket{job=\"agentgateway\", identity=~\"$identity\"}[5m])))", "legendFormat": "{{gen_ai_request_model}}"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 9,
      "title": "LLM tokens by identity, model, and token type",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 29},
      "targets": [{"refId": "A", "expr": "sum by (identity, gen_ai_request_model, gen_ai_token_type) (rate(agentgateway_gen_ai_client_token_usage_sum{job=\"agentgateway\"}[5m]))", "legendFormat": "{{identity}} · {{gen_ai_request_model}} · {{gen_ai_token_type}}"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 10,
      "title": "Rejected requests by reason",
      "type": "timeseries",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37},
      "targets": [{"refId": "A", "expr": "sum by (reason) (rate(agentgateway_requests_total{job=\"agentgateway\", reason!=\"\"}[5m]))", "legendFormat": "{{reason}}"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "id": 11,
      "title": "Rate-limited requests (429)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 37},
      "targets": [{"refId": "A", "expr": "increase(agentgateway_requests_total{job=\"agentgateway\", status=\"429\"}[5m])", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 12,
      "title": "Agentgateway build",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 37},
      "targets": [{"refId": "A", "expr": "agentgateway_build_info{job=\"agentgateway\"}", "instant": true, "format": "table"}],
      "fieldConfig": {"defaults": {}, "overrides": []}
    },
    {
      "id": 13,
      "title": "Recent access records",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 45},
      "targets": [{"refId": "A", "expr": "{service=\"agentgateway\", signal=\"access-log\"}"}]
    },
    {
      "id": 14,
      "title": "Recent agentgateway traces",
      "type": "table",
      "datasource": {"type": "tempo", "uid": "tempo"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 55},
      "targets": [{"refId": "A", "queryType": "traceql", "query": "{ resource.service.name = \"agentgateway\" }"}]
    }
  ]
}
