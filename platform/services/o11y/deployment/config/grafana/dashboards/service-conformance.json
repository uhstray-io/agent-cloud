{
  "annotations": {
    "list": []
  },
  "editable": false,
  "schemaVersion": 39,
  "tags": [
    "agent-cloud",
    "workflow"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "",
  "title": "Service deployment conformance",
  "uid": "service-conformance",
  "version": 1,
  "description": "Per-service status of every service deployment workflow step, as last recorded by Collect Service Conformance (the only writer). Plan 15; change service-deployment-workflow task 7.5.",
  "panels": [
    {
      "title": "Current failed step states",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "description": "Count of unique service and step pairs whose newest state in the last 16 minutes is fail. This is current recorded state, not a count of new failure events. When inventory markers exist but no step is currently failed, the fallback returns one unlabeled zero; with no recent inventory marker the panel shows No recent data.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No recent data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum(last_over_time({job=\"agent-cloud-conformance\", step!=\"none\"} | json state_code | unwrap state_code | __error__=\"\" [16m]) by (service, step) == bool 0) or (sum(last_over_time({job=\"agent-cloud-conformance\", step=\"none\"} | json inventory_code | unwrap inventory_code | __error__=\"\" [16m]) by (service) * 0))"
        }
      ]
    },
    {
      "title": "Services tracked",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No recent data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "count(sum by (service) (count_over_time({job=\"agent-cloud-conformance\"} [16m])))"
        }
      ]
    },
    {
      "title": "Services not yet run",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "description": "Inventoried services whose newest collector inventory marker reports no workflow history.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "last_over_time({job=\"agent-cloud-conformance\", step=\"none\"} | json inventory_code | unwrap inventory_code | __error__=\"\" [16m]) by (service) == 0"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            }
          }
        }
      ]
    },
    {
      "title": "Latest step status by service",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "description": "One row per service and workflow step. State is the newest report in the last 16 minutes and is shown as fail, pass, or skip. An empty result means no step state was reported in that window. Services that have not run any step are listed in \"Services not yet run\", not here.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "fail",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "pass",
                        "color": "green",
                        "index": 1
                      },
                      "2": {
                        "text": "skip",
                        "color": "gray",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "last_over_time({job=\"agent-cloud-conformance\", step!=\"none\"} | json state_code | unwrap state_code | __error__=\"\" [16m]) by (service, step)"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "State"
            }
          }
        }
      ]
    },
    {
      "title": "Recent failed task snapshots",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "description": "Failed task records received during the selected dashboard time range, including the error and Semaphore task id. The collector can repeat the same historical failure in later snapshots, so these rows are not new-event counts and may not match the latest state above. Use the task id to identify the workflow run.",
      "options": {
        "showLabels": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "{job=\"agent-cloud-conformance\", status=\"fail\"}",
          "maxLines": 100
        }
      ]
    },
    {
      "title": "History incomplete",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "description": "Services whose workflow history the collector could not read in full: a template's history filled the 1000-task window, so a step missing here may be older, not absent. NetBox keeps that step's last recorded status.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "last_over_time({job=\"agent-cloud-conformance\", step=\"none\"} | json inventory_code | unwrap inventory_code | __error__=\"\" [16m]) by (service) == 2"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            }
          }
        }
      ]
    }
  ]
}
