# Managed by deploy-o11y.yml. Publishes sanitized volume-size metrics for node-exporter.
[Unit]
Description=Collect a complete o11y named-volume capacity sample

[Service]
Type=oneshot
User={{ _capacity_user }}
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStart=/usr/bin/python3 {{ _capacity_sampler }}
TimeoutStartSec=600
# Rootless Podman needs setuid newuidmap for inspection; keep this exception read-only.
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths={{ _capacity_textfile_dir }}
