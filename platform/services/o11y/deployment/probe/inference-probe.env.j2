{# Rendered by manage-secrets (deploy-o11y.yml _env_templates) to probe/inference-probe.env,
   mode 0600, gitignored, overwritten every deploy. Read only by inference-probe.service
   (systemd EnvironmentFile). A separate file from .env on purpose: Grafana loads .env as
   its env_file, and the inference key has no business in Grafana's environment.
   Change inference-telemetry-production, task 3.3. #}
# Managed by deploy-o11y.yml from OpenBao + inventory. Do not edit on the host.
INFERENCE_PROBE_URL={{ o11y_inference_probe_url }}
INFERENCE_PROBE_MODEL={{ o11y_inference_probe_model }}
INFERENCE_PROBE_KEY={{ secrets[o11y_inference_probe_key_field] }}
INFERENCE_PROBE_TIMEOUT_SECONDS={{ o11y_inference_probe_timeout_seconds | default(30) | int }}
INFERENCE_PROBE_TEXTFILE_DIR={{ _probe_textfile_dir }}
{% if _probe_leaf_dir | default('') | length > 0 %}
{# Gateway client identity (o11y_inference_probe_client_leaf): the probe presents its own
   internal-CA client leaf and verifies the gateway against the bundle placed beside it, the
   paths the leaf's renewal proof uses too. #}
INFERENCE_PROBE_CACERT={{ _probe_leaf_dir | dirname }}/step-ca-bundle.crt
INFERENCE_PROBE_CLIENT_CERT={{ _probe_leaf_dir }}/current/cert.pem
INFERENCE_PROBE_CLIENT_KEY={{ _probe_leaf_dir }}/current/key.pem
{% endif %}
