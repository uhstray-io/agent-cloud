{# The workspace's own credentials, for the orchestrator container only — rendered by
   deploy-weft-workspace.yml through manage-secrets from secret/services/<root>/workspaces/<id>.
   One line per variable weft.toml names (key_from_env, token_from_env); the names come from
   inventory (weft_secret_env), the values from OpenBao, seeded by an operator and never generated.
   0600, gitignored, overwritten on every deploy. Do NOT edit by hand. #}
{% for name in weft_secret_env | default([]) %}
{{ name }}={{ secrets[name] }}
{% endfor %}
