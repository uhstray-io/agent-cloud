{# Compose substitution for one workspace — rendered by deploy-weft-workspace.yml for the release
   being deployed, and again for the previous release when a deploy rolls back. No secret: the
   keys are in secrets.env. Overwritten on every deploy. Do NOT edit by hand. #}
# The release's workspace image, by the digest its signed release.json names.
WEFT_WORKSPACE_IMAGE={{ _weft_images['weft-workspace'] }}
# The workspace directory on the VM's own disk, mounted at the same path inside.
WEFT_WORKSPACE_DIR={{ _weft_workspace_dir }}
# The board's HTTP port, published on the address the Caddy host reaches.
WEFT_BOARD_BIND={{ weft_board_bind | default(ansible_host) }}
WEFT_BOARD_PORT={{ weft_board_port | default(8080) }}
# The workspace's one UDP port for calls; the rack forwards the same number to it.
WEFT_VOICE_UDP={{ weft_voice_udp }}
# The deploy user's rootless podman socket, for the orchestrator only.
WEFT_PODMAN_SOCKET={{ _weft_podman_socket }}
