{# Compose substitution for the front door — rendered by deploy-weft-door.yml for the release
   being deployed, and again for the previous release on a rollback. No secret: the signing key is
   door.key. Overwritten on every deploy. Do NOT edit by hand. #}
# The release's front door image, by the digest its signed release.json names.
WEFT_DOOR_IMAGE={{ _weft_images['weft-door'] }}
# The records' directory on the VM's own disk, mounted at the same path inside.
WEFT_DOOR_DIR={{ _weft_door_dir }}
# Published on the address the Caddy host reaches.
WEFT_DOOR_BIND={{ weft_door_bind | default(ansible_host) }}
WEFT_DOOR_PORT={{ weft_door_port | default(8081) }}
# Where a workspace lives: its front-door id as a DNS label under this environment's domain.
WEFT_DOOR_WORKSPACE_URL=https://{id}.{{ weft_domain }}
