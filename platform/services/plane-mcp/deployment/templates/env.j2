{#-
  .env for plane-mcp — read by Compose for substitution, and passed to the container as env_file.
  Rendered by deploy-plane-mcp.yml. _plane_mcp_client_id and _plane_mcp_client_secret are the OAuth
  client id and secret Plane issued to the registered MCP app, read from OpenBao, never committed. The
  rest is non-secret config. .env is gitignored and overwritten on every deploy. Do NOT edit by hand.
-#}
{%- if not _plane_mcp_client_id -%}
{{ undefined_plane_mcp_client_id | mandatory('env.j2: _plane_mcp_client_id is empty; register the MCP app in Plane first') }}
{%- endif -%}
{%- if not _plane_mcp_client_secret -%}
{{ undefined_plane_mcp_client_secret | mandatory('env.j2: _plane_mcp_client_secret is empty') }}
{%- endif -%}
# --- compose substitution (project name, image tag, host publish) ---
COMPOSE_PROJECT_NAME=plane-mcp
PLANE_MCP_VERSION={{ plane_mcp_version | default('v0.3.5') }}
PLANE_MCP_BIND={{ plane_mcp_bind | default('127.0.0.1') }}
PLANE_MCP_PORT={{ plane_mcp_port | default('8211') }}

# --- Plane: browser-facing and server-to-server URLs ---
# PLANE_BASE_URL is the public Plane URL. The OAuth authorize redirect goes there, so it must be
# reachable from a browser.
# PLANE_INTERNAL_BASE_URL is Plane's api service on plane_default. Every API call goes there.
PLANE_BASE_URL={{ plane_public_url }}
PLANE_INTERNAL_BASE_URL=http://api:8000

# --- this server's public identity and the OAuth app Plane issued it ---
# PLANE_OAUTH_PROVIDER_BASE_URL is this server's public ORIGIN: no trailing slash, no path.
# plane_mcp/server.py appends /http itself.
PLANE_OAUTH_PROVIDER_BASE_URL={{ plane_mcp_public_url }}
PLANE_OAUTH_PROVIDER_CLIENT_ID={{ _plane_mcp_client_id }}
PLANE_OAUTH_PROVIDER_CLIENT_SECRET={{ _plane_mcp_client_secret }}
# Comma-separated extras beyond the built-in redirect allowlist (plane_mcp/server.py DEFAULT_ALLOWED_REDIRECT_URIS).
PLANE_OAUTH_ALLOWED_REDIRECT_URIS={{ plane_mcp_allowed_redirect_uris | default('') }}

# --- OAuth token store: Redis, on its own DB ---
# Same plane-redis instance as Plane. DB 1 keeps the OAuth token store in its own keyspace, out of
# the DB Plane uses.
REDIS_URL=redis://plane-redis:6379/1

# --- logging: no tool content, no user identity ---
# The upstream default is LOG_PAYLOADS=true (plane_mcp/server.py). That logs every tool call's
# arguments and results, which is work-item content, into the container log and Loki. Off here.
# LOG_USER_INFO=true would add display names, which are PII (plane_mcp/__main__.py).
LOG_PAYLOADS=false
LOG_USER_INFO=false
