# Dispatch Console image: builds the Dioxus fullstack crate in app/ and ships
# the server binary plus its public/ assets on distroless.
#
# Context is the parent of this directory (platform/services/console), so
# COPY paths below start at app/. deploy.sh builds it on the host:
#   $CONTAINER_ENGINE build -f deployment/Containerfile platform/services/console
#
# Pins are image INDEX digests (multi-arch: amd64 and arm64 are both listed in
# the index), so the same reference builds on the arm64 dev VM and x86_64 prod hosts.
#   rust:1.96-bookworm           sha256:a339861ae23e9abb272cea45dfafde21760d2ce6577a70f8a926153677902663
#   cc-debian12:nonroot          sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f
# ponytail: host-built image, no registry. Phase 7 moves the build to CI and pins the GHCR digest.

# ---- build ---------------------------------------------------------------
FROM docker.io/library/rust:1.96-bookworm@sha256:a339861ae23e9abb272cea45dfafde21760d2ce6577a70f8a926153677902663 AS build

# wasm-opt 129 (binaryen). dx runs it on every release web build; with NO_DOWNLOADS=1
# it must come from PATH. Not the bookworm binaryen package (108), which is too old for
# this build's wasm. dx's own download has no checksum, so this fetches the official
# release tarball for this architecture and checks it against the sha256 pinned here
# (from the release's .sha256 asset) before installing wasm-opt.
# hadolint ignore=DL4006
RUN set -eux; \
    case "$(uname -m)" in \
      x86_64) bn=x86_64; bn_sha=50b9fa62b9abea752da92ec57e0c555fee578760cd237c40107957715d2976ba ;; \
      aarch64) bn=aarch64; bn_sha=81d46b86b10876ab615eec67e09fcc5615115a7b189cfe3d466725ee36c46ac2 ;; \
      *) echo "unsupported architecture" >&2; exit 1 ;; esac; \
    curl -fsSL -o /tmp/binaryen.tgz "https://github.com/WebAssembly/binaryen/releases/download/version_129/binaryen-version_129-$bn-linux.tar.gz"; \
    printf '%s  %s\n' "$bn_sha" /tmp/binaryen.tgz | sha256sum -c -; \
    tar -xzf /tmp/binaryen.tgz -C /tmp binaryen-version_129/bin/wasm-opt; \
    install -m 0755 /tmp/binaryen-version_129/bin/wasm-opt /usr/local/bin/wasm-opt; \
    rm -rf /tmp/binaryen.tgz /tmp/binaryen-version_129; \
    wasm-opt --version | grep -q 'version 129'

# Client target. Local rustup has it approved; the image installs it explicitly.
RUN rustup target add wasm32-unknown-unknown

# Lockfile first, so the tool layers below cache across source-only changes.
COPY app/Cargo.toml app/Cargo.lock /src/app/

# dx must match the Dioxus pin in app/Cargo.toml (=0.7.10). Exact version
# with --locked: no drift from the upstream dx lockfile.
# The cargo registry cache is deleted in the same RUN, so it never enters a layer.
RUN cargo install --locked --root /usr/local dioxus-cli --version '=0.7.10' \
 && rm -rf "$CARGO_HOME/registry" "$CARGO_HOME/git"

# wasm-bindgen CLI must equal the wasm-bindgen version in Cargo.lock, which
# dx checks by exact match. Read it from the lockfile so the two cannot drift.
RUN set -eux; \
    wb="$(awk -F'"' '/^name = "wasm-bindgen"$/ {getline; print $2}' /src/app/Cargo.lock)"; \
    test -n "$wb"; \
    cargo install --locked --root /usr/local wasm-bindgen-cli --version "=$wb"; \
    rm -rf "$CARGO_HOME/registry" "$CARGO_HOME/git"; \
    wasm-bindgen --version

# esbuild 0.27.3: dx pins this version for JS bundling on every web build. With
# NO_DOWNLOADS=1 dx needs it on PATH. dx's own fetch has no checksum, so this
# takes the same @esbuild tarball from the npm registry and checks it against
# the registry's sha512 integrity field before installing it.
# The pipes below need no pipefail: each one's output feeds a `test -n` or a
# comparison that follows it, so a failed stage leaves an empty value that aborts
# the step. The pragma keeps hadolint's DL4006 (pipefail under /bin/sh) quiet.
# hadolint ignore=DL4006
RUN set -eux; \
    case "$(dpkg --print-architecture)" in amd64) ep=linux-x64 ;; arm64) ep=linux-arm64 ;; \
      *) echo "unsupported architecture" >&2; exit 1 ;; esac; \
    ver=0.27.3; \
    meta="$(curl -fsSL "https://registry.npmjs.org/@esbuild/$ep/$ver")"; \
    integrity="$(printf '%s' "$meta" | grep -o '"integrity":"sha512-[^"]*"' | head -1 | sed 's/.*"sha512-\([^"]*\)"/\1/')"; \
    test -n "$integrity"; \
    curl -fsSL -o /tmp/esbuild.tgz "https://registry.npmjs.org/@esbuild/$ep/-/$ep-$ver.tgz"; \
    test "$(openssl dgst -sha512 -binary /tmp/esbuild.tgz | base64 -w0)" = "$integrity"; \
    tar -xzf /tmp/esbuild.tgz -C /tmp package/bin/esbuild; \
    install -m 0755 /tmp/package/bin/esbuild /usr/local/bin/esbuild; \
    rm -rf /tmp/esbuild.tgz /tmp/package; \
    esbuild --version

COPY app/ /src/app/

# Data dir for the SQLite prefs file. Created here, owned by the runtime uid,
# and copied into the runtime stage: a named volume mounted over /data copies
# this ownership up on first use, so SQLite can write without root.
RUN install -d -m 0750 -o 65532 -g 65532 /data

# NO_DOWNLOADS=1: dx takes wasm-bindgen and wasm-opt from PATH, and verifies
# the wasm-bindgen version, instead of fetching unchecksummed binaries from GitHub.
WORKDIR /src/app
# dx does not fail the build when wasm-opt fails. It logs the error and ships the
# unoptimized wasm, exit 0 (dioxus-cli v0.7.10 wasm_opt.rs, optimize()). So the log is
# checked for that message. dx logs no success message, so this gate is negative only:
# exit 0 and no failure text. The check is an `if`, not `! grep`, because POSIX ignores
# -e for a pipeline that starts with `!`.
# target/ is deleted in the same RUN: only /out is kept in the layer.
RUN set -eux; \
    rc=0; NO_DOWNLOADS=1 dx bundle --web --release --out-dir /out > /tmp/dx.log 2>&1 || rc=$?; \
    cat /tmp/dx.log; \
    test "$rc" -eq 0; \
    if grep -q 'wasm-opt failed with status code' /tmp/dx.log; then \
      echo "wasm-opt failed: the wasm would ship unoptimized" >&2; exit 1; \
    fi; \
    rm -f /tmp/dx.log; \
    ls -la /out /out/public; \
    rm -rf /src/app/target "$CARGO_HOME/registry" "$CARGO_HOME/git"

# ---- runtime -------------------------------------------------------------
# distroless cc: glibc and libgcc, no shell, no package manager. nonroot runs as 65532.
FROM gcr.io/distroless/cc-debian12:nonroot@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f

WORKDIR /usr/local/app
# /out holds the server binary (server) and the client bundle (public/).
# server reads public/ from the directory next to its own executable.
COPY --from=build --chown=65532:65532 /out/ /usr/local/app/
COPY --from=build --chown=65532:65532 /data /data

# dioxus::serve binds IP:PORT from these. 0.0.0.0 is needed inside the container.
ENV IP=0.0.0.0 PORT=8080
EXPOSE 8080

# Exec form, no shell in distroless. The probe speaks HTTP over std sockets.
# Note: podman's default OCI image format drops HEALTHCHECK, so the compose
# healthcheck is the one that counts.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/usr/local/app/server", "probe", "/healthz", "200"]

USER 65532:65532
ENTRYPOINT ["/usr/local/app/server"]
