{#- console flows — rendered by deploy-console.yml to config/flows.json (plan 17, D24). Names only: an edge
    names an authentik app slug, the caddy site hostname, or an o11y job/service. The inputs carry
    addresses (caddy upstreams, o11y instances, ports); this template reads none of those fields. The
    edges are typed from the declarations: oidc and forward_auth from the authentik catalog type, edge from
    the caddy site address, metrics from the o11y expected targets. Do NOT edit by hand. -#}
{%- set edges = [] -%}
{%- for app in _console_authentik_apps -%}
{%- set _ = edges.append({'kind': _console_authentik_catalog.get(app, {}).get('type', 'unknown'), 'from': app, 'to': 'authentik'}) -%}
{%- endfor -%}
{%- for host in _console_caddy_sites | regex_findall('^[ ]*((?:[a-z0-9-]+[.])+[a-z]{2,})(?:[:][0-9]+)?[ ]*[{]', multiline=True) | unique -%}
{%- set _ = edges.append({'kind': 'edge', 'from': 'caddy', 'to': host}) -%}
{%- endfor -%}
{%- for target in _console_o11y_targets -%}
{%- set _name = target.get('service') or target.get('job') or '' -%}
{%- if _name | string | length > 0 -%}
{%- set _ = edges.append({'kind': 'metrics', 'from': _name | string, 'to': 'o11y'}) -%}
{%- endif -%}
{%- endfor -%}
{{ {'edges': edges} | to_nice_json }}
