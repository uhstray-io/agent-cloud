{# console compose env — rendered by deploy-console.yml from inventory, the OIDC client secret (a
   _shared_read from authentik, which owns it) and the Semaphore API token (the svc-console
   account's, stored by provision-console-semaphore-access.yml; deploy-console only reads it).
   Its SQLite preferences are non-secret. .env is gitignored and overwritten on every deploy.
   Do NOT edit by hand. #}
# --- compose substitution (image + published bind/port) ---
# The local tag must match deploy.sh's CONSOLE_IMAGE_DEFAULT: deploy.sh builds this image.
CONSOLE_IMAGE={{ console_image | default('localhost/agent-cloud-console:local') }}
CONSOLE_BIND={{ console_bind | default('127.0.0.1') }}
CONSOLE_PORT={{ console_port | default('3410') }}

# --- console runtime config (the container reads these) ---
# The server listens on 0.0.0.0:8080 inside the container; the host publish is CONSOLE_BIND:CONSOLE_PORT.
IP=0.0.0.0
PORT=8080
# Redirect URI is CONSOLE_BASE_URL + /auth/callback; no trailing slash.
CONSOLE_BASE_URL={{ console_base_url | default('https://console.agent-cloud.test:8443') }}
CONSOLE_OIDC_ISSUER={{ console_oidc_issuer | default('https://auth.agent-cloud.test:8443/application/o/console/') }}
CONSOLE_OIDC_CLIENT_ID=console
CONSOLE_OIDC_CLIENT_SECRET={{ secrets.console_oidc_client_secret }}
CONSOLE_DATA_DIR=/data
CONSOLE_SCOPE_FILE=/etc/console/scope.json

# --- Semaphore work source (Phase 2, D17-D20). All-or-none (app/src/server/config.rs): none set
# answers /v1/work with source "unconfigured"; a partial set fails startup naming the missing one. The token is the svc-console account's: guest role,
# no run permission, never the controller's token. The API URL is read server-side; the UI URL is
# where the browser links open.
CONSOLE_SEMAPHORE_API_URL={{ console_semaphore_api_url | default('https://semaphore.agent-cloud.test') }}
CONSOLE_SEMAPHORE_UI_URL={{ console_semaphore_ui_url | default('https://semaphore.agent-cloud.test:8443') }}
CONSOLE_SEMAPHORE_PROJECT={{ console_semaphore_project | default('1') }}
CONSOLE_SEMAPHORE_TOKEN={{ secrets.semaphore_api_token }}
# The registry's steps, rendered by deploy-console.yml (config/workflow.json, bind-mounted read-only).
CONSOLE_WORKFLOW_FILE=/etc/console/workflow.json
# The data-flow edges (D24), rendered by deploy-console.yml from the authentik, caddy and o11y declarations.
# Names only. Always set: the file is always rendered, possibly with no edges.
CONSOLE_FLOWS_FILE=/etc/console/flows.json
# The agentgateway clients, budgets and models (task 8.3a), rendered by deploy-console.yml from the agentgateway host's
# vars. Names and figures only. Always set: the file is always rendered, with empty lists when no gateway host exists.
CONSOLE_GATEWAY_FILE=/etc/console/gateway.json
# The Request a service page's list (task 8.4, D38), rendered by deploy-console.yml from the deploy templates. Names and
# host counts only. Always set: the file is always rendered (an empty list when no deploy template qualifies).
CONSOLE_CATALOG_FILE=/etc/console/catalog.json

# The Access page's role map (8.2b), rendered by deploy-console.yml from vars/access-role-map.yml. Always set: the
# file is always rendered (config/role-map.json).
CONSOLE_ROLE_MAP_FILE=/etc/console/role-map.json

# --- Authentik directory (8.2b). Read-only users and groups for the Access page (GET /v1/access). All-or-none
# (app/src/server/config.rs): rendered only when console_authentik_api_url is set, so a deploy without it stays
# "unconfigured" and reads no token. The token is a view-only service account's (svc-console-directory, which holds
# view_user and view_group only), shared-read from secret/services/authentik by deploy-console.yml.
{% if (console_authentik_api_url | default('', true) | string | trim | length) > 0 %}
CONSOLE_AUTHENTIK_URL={{ console_authentik_api_url }}
CONSOLE_AUTHENTIK_TOKEN={{ secrets.console_directory_token }}
{% endif %}

# --- Phase 3 read-only inventory (D22). Each group is all-or-none (app/src/server/config.rs): rendered only
# when its URL var is set, so a deploy without the var stays "unconfigured" and reads no token. The token is
# the read-only one: a NetBox view-only token (provision-netbox-automation-token.yml, profile console) and a
# PVEAuditor token (provision-console-proxmox-token.yml), both shared-read by deploy-console.yml.
{% if (console_netbox_url | default('', true) | string | trim | length) > 0 %}
CONSOLE_NETBOX_URL={{ console_netbox_url }}
CONSOLE_NETBOX_TOKEN={{ secrets.console_api_token }}
{% endif %}
{% if (console_proxmox_url | default('', true) | string | trim | length) > 0 %}
CONSOLE_PROXMOX_URL={{ console_proxmox_url }}
CONSOLE_PROXMOX_TOKEN_ID={{ secrets.console_token_id }}
CONSOLE_PROXMOX_TOKEN={{ secrets.console_token }}
{% if (console_proxmox_ca_pem | default('', true) | string | trim | length) > 0 %}
# The CA file is mounted read-only at this path by compose.yml (config/proxmox-ca.pem).
CONSOLE_PROXMOX_CA_FILE=/etc/console/proxmox-ca.pem
{% endif %}
{% endif %}
# --- OpenBao (D27). The console logs in at run time with its own AppRole, to read secret/services/console/* (the
# GitHub token) and OpenBao metadata. Rendered only when console_openbao_url is set, with both fields together:
# role_id and secret_id are shared-read from approles/console (provision-console-approle.yml writes them;
# rotate-console-credentials.yml rotates secret_id). The server logs in lazily on first use (server/openbao.rs).
{% if (console_openbao_url | default('', true) | string | trim | length) > 0 %}
CONSOLE_OPENBAO_URL={{ console_openbao_url }}
CONSOLE_OPENBAO_ROLE_ID={{ secrets.role_id }}
CONSOLE_OPENBAO_SECRET_ID={{ secrets.secret_id }}
# The Policy page's GitHub source (D36): the repository and ref its OPA and OpenBao policy files are read from. Rendered
# with the OpenBao block because the token is read from OpenBao on every refresh and is never rendered here. Defaults:
# uhstray-io/agent-cloud and dev. deploy-console.yml refuses a value server/config.rs would refuse.
CONSOLE_GITHUB_REPO={{ console_github_repo | default('uhstray-io/agent-cloud') }}
CONSOLE_GITHUB_REF={{ console_github_ref | default('dev') }}
{% endif %}
# Base URL for Grafana deep links from the console. Not a credential. Rendered only when set.
{% if (console_grafana_url | default('', true) | string | trim | length) > 0 %}
CONSOLE_GRAFANA_URL={{ console_grafana_url }}
{% endif %}
# --- Grafana API (D26). Renders the console's Viewer token, shared-read from o11y (provision-console-grafana-token.yml
# stores it), only when console_grafana_api_enabled is true AND console_grafana_url is set. The Telemetry rollups read
# through the Grafana API with it. The URL alone is a deep-link base and renders no token.
{% if (console_grafana_api_enabled | default(false) | bool) and (console_grafana_url | default('', true) | string | trim | length) > 0 %}
CONSOLE_GRAFANA_TOKEN={{ secrets.console_grafana_token }}
{% endif %}

# --- Launch gate (D49, plan 17). Rendered only when console_launch_gate_url is set. The caller token is a shared read of
# secret/services/launch-gate:caller_console_token (the launch-gate deploy generates it once console is a token caller;
# this file renders it into .env and nothing writes it back). The console presents it as a bearer token to POST /v1/launch.
{% if (console_launch_gate_url | default('', true) | string | trim | length) > 0 %}
CONSOLE_LAUNCH_GATE_URL={{ console_launch_gate_url }}
CONSOLE_LAUNCH_GATE_TOKEN={{ secrets.caller_console_token }}
{% if not (local_mode | default(false) | bool) %}
# Production name mapping for compose.launch-gate.yml (extra_hosts), as the skynet gate's is. Outside local mode only.
CONSOLE_LAUNCH_GATE_HOSTNAME={{ console_launch_gate_url | urlsplit('hostname') }}
CONSOLE_LAUNCH_GATE_IP={{ console_launch_gate_ip }}
{% endif %}
{% endif %}

# --- Launch dev variants (D53). When true (the default) the console launches each template's (Dev) variant, because
# production runs the (Dev) variants until promotion. Always rendered, so the flag is never implicit.
CONSOLE_LAUNCH_DEV_VARIANTS={{ console_launch_dev_variants | default(true) | bool | lower }}
