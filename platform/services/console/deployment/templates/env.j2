{# console compose env — rendered by deploy-console.yml from inventory, the OIDC client secret (a
   _shared_read from authentik, which owns it) and the Semaphore API token (the svc-console
   account's, stored by provision-console-semaphore-access.yml; deploy-console only reads it).
   Its SQLite preferences are non-secret. .env is gitignored and overwritten on every deploy.
   Do NOT edit by hand. #}
# --- compose substitution (image + published bind/port) ---
# The local tag must match deploy.sh's CONSOLE_IMAGE_DEFAULT: deploy.sh builds this image.
CONSOLE_IMAGE={{ console_image | default('localhost/agent-cloud-console:local') }}
CONSOLE_BIND={{ console_bind | default('127.0.0.1') }}
CONSOLE_PORT={{ console_port | default('3410') }}

# --- console runtime config (the container reads these) ---
# The server listens on 0.0.0.0:8080 inside the container; the host publish is CONSOLE_BIND:CONSOLE_PORT.
IP=0.0.0.0
PORT=8080
# Redirect URI is CONSOLE_BASE_URL + /auth/callback; no trailing slash.
CONSOLE_BASE_URL={{ console_base_url | default('https://console.agent-cloud.test:8443') }}
CONSOLE_OIDC_ISSUER={{ console_oidc_issuer | default('https://auth.agent-cloud.test:8443/application/o/console/') }}
CONSOLE_OIDC_CLIENT_ID=console
CONSOLE_OIDC_CLIENT_SECRET={{ secrets.console_oidc_client_secret }}
CONSOLE_DATA_DIR=/data
CONSOLE_SCOPE_FILE=/etc/console/scope.json

# --- Semaphore work source (Phase 2, D17-D20). All-or-none (app/src/server/config.rs): none set
# answers /v1/work with source "unconfigured"; a partial set fails startup naming the missing one. The token is the svc-console account's: guest role,
# no run permission, never the controller's token. The API URL is read server-side; the UI URL is
# where the browser links open.
CONSOLE_SEMAPHORE_API_URL={{ console_semaphore_api_url | default('https://semaphore.agent-cloud.test') }}
CONSOLE_SEMAPHORE_UI_URL={{ console_semaphore_ui_url | default('https://semaphore.agent-cloud.test:8443') }}
CONSOLE_SEMAPHORE_PROJECT={{ console_semaphore_project | default('1') }}
CONSOLE_SEMAPHORE_TOKEN={{ secrets.semaphore_api_token }}
# The registry's steps, rendered by deploy-console.yml (config/workflow.json, bind-mounted read-only).
CONSOLE_WORKFLOW_FILE=/etc/console/workflow.json
# The data-flow edges (D24), rendered by deploy-console.yml from the authentik, caddy and o11y declarations.
# Names only. Always set: the file is always rendered, possibly with no edges.
CONSOLE_FLOWS_FILE=/etc/console/flows.json

# --- Phase 3 read-only inventory (D22). Each group is all-or-none (app/src/server/config.rs): rendered only
# when its URL var is set, so a deploy without the var stays "unconfigured" and reads no token. The token is
# the read-only one: a NetBox view-only token (provision-netbox-automation-token.yml, profile console) and a
# PVEAuditor token (provision-console-proxmox-token.yml), both shared-read by deploy-console.yml.
{% if (console_netbox_url | default('', true) | string | trim | length) > 0 %}
CONSOLE_NETBOX_URL={{ console_netbox_url }}
CONSOLE_NETBOX_TOKEN={{ secrets.console_api_token }}
{% endif %}
{% if (console_proxmox_url | default('', true) | string | trim | length) > 0 %}
CONSOLE_PROXMOX_URL={{ console_proxmox_url }}
CONSOLE_PROXMOX_TOKEN_ID={{ secrets.console_token_id }}
CONSOLE_PROXMOX_TOKEN={{ secrets.console_token }}
{% if (console_proxmox_ca_pem | default('', true) | string | trim | length) > 0 %}
# The CA file is mounted read-only at this path by compose.yml (config/proxmox-ca.pem).
CONSOLE_PROXMOX_CA_FILE=/etc/console/proxmox-ca.pem
{% endif %}
{% endif %}
# Base URL for Grafana deep links from the console. Not a credential. Rendered only when set.
{% if (console_grafana_url | default('', true) | string | trim | length) > 0 %}
CONSOLE_GRAFANA_URL={{ console_grafana_url }}
{% endif %}
