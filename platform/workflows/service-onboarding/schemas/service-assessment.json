{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uhstray.io/agent-cloud/schemas/service-assessment.json",
  "title": "Service assessment proposal body (step service-assess)",
  "type": "object",
  "additionalProperties": false,
  "required": ["vm_spec", "deploy_template", "runtime", "expected_ports", "depends_on", "readiness_checks", "risks", "verdict"],
  "properties": {
    "vm_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cores", "memory_mb", "disk_gb"],
      "properties": {
        "cores": {"type": "integer", "minimum": 1},
        "memory_mb": {"type": "integer", "minimum": 512},
        "disk_gb": {"type": "integer", "minimum": 8}
      }
    },
    "deploy_template": {"type": "string", "minLength": 1, "description": "An existing Deploy template for the service; never a destructive template."},
    "runtime": {"enum": ["podman", "docker"]},
    "expected_ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["port", "proto", "consumer"],
        "properties": {
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "proto": {"enum": ["tcp", "udp"]},
          "consumer": {"type": "string", "minLength": 1}
        }
      }
    },
    "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "readiness_checks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verdict": {"$ref": "verdict.json"}
  }
}
