---
# =============================================================================
# TEMPLATE for the local-dev inventory, not production. Production is
# site-config/inventory/production.yml. Local dev runs from the gitignored copy
# `make local-init` writes (platform/inventory/local-dev.yml), which can carry
# local overrides; nothing here says what production is configured with
# (docs/MISTAKES.md 1.14).
# =============================================================================
# Local-dev inventory TEMPLATE — committed, localhost-only by construction.
# `make local-init` copies this to platform/inventory/local-dev.yml (gitignored)
# and substitutes __REPO_DIR__ / __GENESIS_DIR__. No real IPs, domains, or
# credentials may ever appear here (plan/development/LOCAL-DEV-DEPLOYMENT.md).

all:
  vars:
    local_mode: true
    monorepo_repo: "https://github.com/uhstray-io/agent-cloud.git"
    openbao_addr: "http://127.0.0.1:8200"
    # Mac-side port the local Semaphore is published on (container side stays 3000).
    # Change it in the gitignored working copy when another local app holds
    # 127.0.0.1:3000; an integer 1024-65535. Re-run `make local-bootstrap` to apply.
    # Avoid ports the stack already uses on the Mac: 3001 (UhhCraft when run with
    # UHHCRAFT_PORT=3001), 3002 (Grafana), 3100 (Loki, also the collector's Loki URL),
    # 3402 (tududi), 5678 (n8n), 8088/8443 (Caddy), 8200 (OpenBao), 9000 (step-ca).
    local_semaphore_port: 3000
    # Genesis (Mac-direct) foundation deploys (§12A) place the repo like every
    # composable deploy: rsync local_workspace_dir (the working tree) into a
    # SEPARATE writable copy at local_monorepo_dir, then run deploy.sh from
    # there. The genesis dir sits under $HOME, which podman-machine auto-mounts
    # into the VM at the SAME absolute path — so deploy.sh's compose bind-mounts
    # (./config, ./certs) resolve on the VM engine. The two MUST differ: never
    # point local_monorepo_dir at the working tree (deploys render .env/certs
    # into it). Tier-3 (Semaphore) deploys use their own paths baked into
    # bootstrap-local-dev.yml's _inv_ini (/var/lib/agent-cloud-deploy), not these.
    local_workspace_dir: "__REPO_DIR__"
    local_monorepo_dir: "__GENESIS_DIR__"
    local_home_dir: "__GENESIS_DIR__"
    ansible_python_interpreter: "{{ ansible_playbook_python }}"

    # The platform administrators (members of the Authentik platform-admins group) are ONE
    # declared list, read by the Authentik deploy (accounts, passwords) and the agentgateway
    # deploy (a gateway identity per entry). It is NOT set here: with no `platform_admins` the
    # committed default in platform/playbooks/vars/platform-admins.yml applies, built from the
    # per-user vars (wisward_*, jacob_*, stray_admin_email). Declaring it in an inventory
    # REPLACES that default entirely; production declares its real list in site-config. The
    # default's shape, with placeholders only:
    #   platform_admins:
    #   - { key: stray_admin, username: stray, name: stray, email: stray@agent-cloud.test }
    #   - { key: agent_cloud_admin, username: agent-cloud-admin, name: "agent-cloud Admin", email: agent-cloud-admin@agent-cloud.test }
    #   - { key: wisward, username: wisward, name: "Platform Admin", email: wisward@agent-cloud.test }
    #   - { key: jacob, username: jacob, name: "Platform Admin 2", email: jacob@agent-cloud.test }
    #   - { key: svc_automation, username: svc-automation, name: "Platform Service Account", type: service_account }
    # `key` (lowercase) names the existing OpenBao field `<key>_password` and the worker env
    # prefix, so it must equal today's name: renaming one re-keys a stored password.
    # `type: service_account` is Authentik-only (no email, no password); `agw_identity` is
    # optional and gateway-only. What the credential print playbook may print is NOT driven by
    # this list: it is a committed constant (`_platform_admins_printable_keys`) next to the
    # default, because the list is launcher-controllable. `platform_admins_exceptions` (names only, default empty)
    # lists platform-admins members that are deliberately not in the list; the Authentik
    # verify accepts them and fails on any other member.
    # Accounts to DELETE are declared as ONE list of usernames, `platform_retired_accounts`
    # (default empty, so nothing is retired). Remove the account from `platform_admins` first:
    # the deploy refuses a name that is also active (or an exception) and the system accounts. Shape:
    #   platform_retired_accounts: []
    # List the usernames to retire, then run Deploy Authentik; its verify proves each one gone.

  children:
    # Local DNS (hickory-dns) — authoritative for the dev zone, forwards the rest.
    # Local zone: `agent-cloud.test` — under the RFC 6761 reserved `.test` TLD
    # (never publicly resolvable -> safe split-DNS, no mDNS clash like `.local`,
    # no forced-HTTPS like a real `.dev`), carrying the agent-cloud name. The zone
    # is written LITERALLY here and in caddy_internal_zone / caddy_routes /
    # stepca_dns_names below, plus bootstrap-local-dev.yml's _inv_ini — keep them
    # in sync. (It must be a literal, NOT a `{{ var }}` ref: host-side scripts read
    # it via `ansible-inventory --host`, which dumps vars raw without evaluating
    # Jinja.) Override in this gitignored working copy for a different local zone.
    dns_svc:
      hosts:
        dns-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: dns
          monorepo_deploy_path: platform/services/dns/deployment
          container_engine: podman
          dns_zone: agent-cloud.test
          dns_listen: 0.0.0.0       # VM bind; podman-machine forwards to the Mac
          dns_port: 5300            # host publish port (mDNS/VPN-safe on macOS)
          dns_wildcard_target: 127.0.0.1
          dns_upstreams: ["1.1.1.1", "1.0.0.1"]

    # step-ca — internal CA (stable root; issues certs for the dev zone). Caddy
    # reaches it by container name on the local-dev network (step-ca:9000); the
    # published loopback port is for host debugging.
    step_ca_svc:
      hosts:
        step-ca-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: step-ca
          monorepo_deploy_path: platform/services/step-ca/deployment
          container_engine: podman
          stepca_bind: 127.0.0.1
          stepca_port: 9000
          stepca_name: "agent-cloud Internal CA (local)"
          stepca_dns_names: "step-ca,localhost,step-ca.agent-cloud.test"

    # Local Caddy — internal-CA TLS on loopback high ports; reverse-proxies the
    # control-plane containers by their local-dev network name. Add routes for
    # other local services as they come up.
    caddy_svc:
      hosts:
        caddy-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: caddy
          monorepo_deploy_path: platform/services/caddy/deployment
          container_engine: podman
          caddy_image: docker.io/library/caddy:2.11.4-alpine
          caddy_file: ./Caddyfile.local
          caddy_http_bind: 127.0.0.1
          caddy_http_port: 8088
          caddy_https_bind: 127.0.0.1
          caddy_https_port: 8443
          # Serve the step-ca-minted wildcard leaf (stable shared root). Set
          # these to switch off Caddy's own ephemeral internal CA (local_certs).
          # Container paths (mounted from ./certs by compose.local.yml); the
          # leaf is minted by tasks/mint-internal-cert.yml on each deploy.
          # Requires step-ca deployed first (make local-deploy-step-ca).
          caddy_internal_zone: agent-cloud.test
          caddy_tls_cert: /etc/caddy/certs/wildcard.crt
          caddy_tls_key: /etc/caddy/certs/wildcard.key
          # Each entry is {host, upstream}. Most upstreams are local-dev
          # container names; NetBox is the exception — it runs in its own compose
          # project (not local-dev), so it's reached via the host gateway
          # (host.containers.internal). Drop the NetBox line if you don't run it.
          caddy_routes:
            - { host: "semaphore.agent-cloud.test", upstream: "local-semaphore:3000" }
            # forward_auth gates the OpenBao UI through Authentik (network gate;
            # OpenBao's own token auth still applies). Internal control-plane
            # access uses local-openbao:8200 directly, so it's unaffected.
            - { host: "openbao.agent-cloud.test", upstream: "local-openbao:8200", forward_auth: "authentik-server:9000" }
            # forward_auth gates NetBox through Authentik's embedded outpost
            # (NetBox can't do OIDC locally — see netbox-forward-auth.yaml).
            - { host: "netbox.agent-cloud.test", upstream: "host.containers.internal:8000", forward_auth: "authentik-server:9000" }
            - { host: "grafana.agent-cloud.test", upstream: "o11y-grafana:3000" }
            # internal_https_port: also listen on :8443 in-network so OIDC
            # clients (ERPNext/Semaphore/… backends) reach the IdP at the same
            # host:port the browser uses (AUTH-SSO-DEPLOYMENT.md OIDC enabler).
            - { host: "auth.agent-cloud.test", upstream: "authentik-server:9000", internal_https_port: 8443 }
            # forward_auth gates n8n through Authentik's embedded outpost
            # (community n8n has no native OIDC — see n8n-forward-auth.yaml).
            - { host: "n8n.agent-cloud.test", upstream: "workflow-n8n:5678", forward_auth: "authentik-server:9000" }
            - { host: "erp.agent-cloud.test", upstream: "erpnext-frontend:8080" }
            # tududi uses NATIVE OIDC (not forward_auth) - plain reverse_proxy.
            - { host: "todo.agent-cloud.test", upstream: "tududi:3002" }
            # console uses NATIVE OIDC (not forward_auth) - plain reverse_proxy, like tududi.
            - { host: "console.agent-cloud.test", upstream: "console:8080" }
            # honcho: /v3 API is JWT-authenticated in-app; only the human /docs
            # surface is Authentik-gated (path-scoped forward_auth).
            - { host: "memory.agent-cloud.test", upstream: "honcho-api:8000", forward_auth: "authentik-server:9000", forward_auth_paths: ["/docs*", "/redoc*", "/openapi.json"] }
            # postiz uses NATIVE OIDC (not forward_auth) — plain reverse_proxy.
            # An edge gate would also gate /api/public/v1, breaking n8n's
            # API-key calls; postiz authenticates interactively in-app instead.
            - { host: "postiz.agent-cloud.test", upstream: "postiz:5000" }
            # plane uses in-app auth, so plain reverse_proxy like postiz. The upstream is the
            # stack's own proxy container (plane-proxy:80), which joins the local-dev network.
            - { host: "plane.agent-cloud.test", upstream: "plane-proxy:80" }
            # inference — the OpenAI-compatible edge, the same shape as prod: this route
            # fronts the local agentgateway's default listener (/v1), which holds the
            # per-client keys and budgets. inference_api renders the /v1 + /health
            # allowlist with an edge 401 and 404-for-everything-else. In-network clients
            # (skynet) reach it at https://inference.agent-cloud.test/v1 (port 443).
            # The gateway's upstream is the public edge (agentgateway_svc below).
            - { host: "inference.agent-cloud.test", upstream: "agentgateway:4000", inference_api: true }
            # agentgateway operator UI — the gateway runs its own OIDC login against
            # Authentik (ui.policies), so this is a plain proxy to its UI listener.
            - { host: "admin.inference.agent-cloud.test", upstream: "agentgateway:4001" }
            # agentgateway MCP endpoint (change agentgateway-mcp) — mcp_api renders the same
            # allowlist shape for the EXACT path /mcp only (Bearer-shape 401 at the edge, the
            # gateway's key check is the authentication; everything else, /sse included, is a
            # 404). The upstream is the gateway's `default` listener (:4000), the one that
            # serves /mcp; the single-label host sits under the wildcard certificate.
            - { host: "mcp.agent-cloud.test", upstream: "agentgateway:4000", mcp_api: true }
            # OPA — the decision API (platform/services/opa), over HTTPS so callers such as skynet
            # verify its certificate via step-ca instead of trusting plain http on the shared network.
            # A plain proxy with NO edge gate: OPA's Phase 1 stays unauthenticated, and this route
            # adds server authentication only. Upstream opa:8181 is in-network plain HTTP.
            - { host: "opa.agent-cloud.test", upstream: "opa:8181" }

    # Authentik — central IdP / SSO. Server+worker+Postgres+Redis; serves HTTP
    # on :9000 behind Caddy (TLS). Deploy: make local-deploy-authentik. The
    # `auth.agent-cloud.test` Caddy route + forward_auth gating land in AUTH
    # Phase 1/2 (AUTH-SSO-DEPLOYMENT.md), not here.
    authentik_svc:
      hosts:
        authentik-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: authentik
          monorepo_deploy_path: platform/services/authentik/deployment
          container_engine: podman
          authentik_bind: 127.0.0.1
          authentik_port: 9300          # host debug port; step-ca owns 9000. Caddy reaches the container's :9000 by name.

    # Observability stack — Grafana + Prometheus + Loki + Alloy. Grafana fronts
    # via Caddy (grafana.agent-cloud.test); host debug ports below. Deploy:
    # make local-deploy-o11y. Plan: O11Y-DEPLOYMENT.md.
    o11y_svc:
      hosts:
        o11y-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: o11y
          monorepo_deploy_path: platform/services/o11y/deployment
          container_engine: podman
          o11y_grafana_port: 3002
          o11y_prom_port: 9090
          o11y_prom_retention_size: 1GB  # local cap; production must size its own disk first
          o11y_scrape_sample_limit: 2000
          o11y_expected_metrics_targets_reviewed: false
          o11y_expected_metrics_targets:
            - uid: o11y_missing_caddy
              job: caddy
              instance: "caddy:2021"
              service: caddy-reverse-proxy/caddy
              cluster: agent-cloud-local
              environment: local
          o11y_alerts_enabled: false  # enable only after the OpenBao webhook is approved and seeded
          o11y_loki_port: 3100

    # OPA — Guardrail-layer policy engine. Agents/control-plane reach it as
    # opa:8181 on local-dev; published to 127.0.0.1:8281 for host diagnostics.
    opa_svc:
      hosts:
        opa-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: opa
          monorepo_deploy_path: platform/services/opa/deployment
          container_engine: podman
          opa_bind: 127.0.0.1
          opa_port: 8281

    # n8n — workflow automation (composable; greenfield locally). Behind Caddy
    # at n8n.agent-cloud.test. The encryption key is stateful (see deploy-n8n.yml).
    n8n_svc:
      hosts:
        n8n-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: n8n
          monorepo_deploy_path: platform/services/n8n/deployment
          container_engine: podman
          n8n_bind: 127.0.0.1
          # docker.n8n.io rate-limits unauthenticated pulls; the Docker Hub
          # mirror is the same image. Base compose default stays docker.n8n.io.
          n8n_image: docker.io/n8nio/n8n:2.25.7
          # Postiz credential host for provision-n8n-postiz-credential.yml —
          # the n8n app container shares the local-dev network with postiz, so
          # the in-container test reaches it directly (no .test DNS / CA trust
          # inside the container). Same /api path shape as the public route.
          n8n_postiz_credential_host: "http://postiz:5000/api"

    # tududi - self-hosted to-do app (single rootless container, SQLite). Native
    # OIDC to Authentik (blueprints/tududi-oidc.yaml). Behind Caddy at
    # todo.agent-cloud.test. Deploy: make local-deploy-tududi.
    tududi_svc:
      hosts:
        tududi-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: tududi
          monorepo_deploy_path: platform/services/tududi/deployment
          container_engine: podman
          tududi_bind: 127.0.0.1
          tududi_port: 3402   # host debug port; Caddy reaches the container :3002 by name
          # The tududi user the GitHub sync acts AS (Store tududi API Token mints
          # its token). It must be the user who OWNS the mapped projects: tududi
          # scopes lists per user, and a task the token creates is invisible to
          # a project owner who is not the token's user. Locally the mapped
          # dev-test project belongs to the deploy's break-glass account, which
          # is also the default — set this only if you map a project you own
          # through your OIDC login instead.
          tududi_sync_user_email: admin@agent-cloud.test
    # console — the Dispatch Console (Rust/Dioxus app; SQLite preferences on a named volume). Native
    # OIDC to Authentik (client `console`), behind Caddy at console.agent-cloud.test. The image is
    # built on this host from platform/services/console (no registry). Deploy: make local-deploy-console.
    console_svc:
      hosts:
        console-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: console
          monorepo_deploy_path: platform/services/console/deployment
          container_engine: podman
          console_bind: 127.0.0.1
          console_port: 3410   # host debug port; Caddy reaches the container :8080 by name
          # The local podman client sends its own default seccomp path to the podman-machine engine,
          # which has the profile only at this path ON THE ENGINE. Without it the image build's RUN
          # steps fail "opening seccomp profile failed" (the NetBox build hit this 2026-09-22).
          console_build_seccomp: /usr/share/containers/seccomp.json
          # The Phase 2 work source: the Semaphore API the console reads server-side, the UI its links
          # open, and the project it lists. Its token is the svc-console account's, stored by
          # Provision Console Semaphore Access (guest; no run permission).
          console_semaphore_api_url: https://semaphore.agent-cloud.test
          console_semaphore_ui_url: https://semaphore.agent-cloud.test:8443
          console_semaphore_project: 1
          # Example scope only: no real tenants, sites or addresses. Production declares its own in
          # site-config. Sites and environments here are names, not hosts.
          console_scope_is_example: true
          console_tenants:
            - id: uhstray
              name: "Uhstray (example)"
              # Authentik groups that may see this tenant (platform-admins sees every tenant).
              groups: [platform-admins, platform-developers]
              orgs:
                - id: uhstray-io
                  name: uhstray-io
                  sites:
                    - { id: site-hq, name: HQ, envs: [prod, dev] }
                    - { id: do-nyc1, name: DigitalOcean NYC1, envs: [prod] }
                    - { id: cloudflare, name: Cloudflare, envs: [prod] }
    # agentgateway — the inference edge gateway (OpenAI-compatible /v1 with
    # per-client API keys + limits) in front of the model API. Locally the
    # upstream is the PUBLIC edge, https://inference.uhstray.io/v1 (prod's route to
    # vLLM on the DGX Spark head node), authenticated with the prod identity
    # `local-gateway`: its key is seeded into local OpenBao (operator step). On the
    # LAN the upstream is the DGX directly; that address stays in this gitignored
    # file, never in the committed example. Prod points the same shape at vLLM
    # via site-config. Deploy: make local-deploy-agentgateway.
    # Change: plan/development/openspec/changes/inference-gateway-agentgateway
    agentgateway_svc:
      hosts:
        agentgateway-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: agentgateway
          monorepo_deploy_path: platform/services/agentgateway/deployment
          container_engine: podman
          # Local debug publishes (127.0.0.1:4400 api, :4401 readiness, :4402 metrics) are
          # literals in compose.local.yml; the UI is reachable only via Caddy + SSO.
          # LAN override (DGX directly, no public edge): http://<dgx-address>:<port>/v1 in your
          # gitignored local-dev.yml. Placeholder text only; never commit a real address here.
          agw_upstream_base_url: https://inference.uhstray.io/v1
          agw_models:
            # The name clients send. No upstream_model: the upstream receives the same name, which
            # is the name prod's gateway lists (plan/development/openspec/changes/inference-gateway-agentgateway).
            - { name: qwen3.8-flash-next }
          # One API-key identity each; manage-secrets mints client_<name> once
          # into secret/services/agentgateway and reuses it on every deploy.
          agw_clients:
            - dev-local
            - isolation-probe
            # The MCP target's own identity (agentgateway-mcp task 4.2): the gateway presents its key
            # to its own /v1 over the loopback listener, so a model request made through MCP is
            # charged to it and logged as `mcp-self`. Never handed out, and refused on /mcp. Enrolled
            # on /v1 whether or not MCP is on; keep it AFTER the person identities (the deploy's verify
            # defaults to the first one).
            - mcp-self
            # skynet's role identities (plan/development/15-service-deployment-workflow-agents.md,
            # including the eval identity): one key each, enrolled on /v1 for skynet's agents.
            - infra-agent
            - security-agent
            - o11y-agent
            - service-agent
            - network-agent
            - skynet-eval
          # isolation-probe: local probe identity for "Probe agentgateway Isolation (Dev)", a budget
          # small enough to exhaust in two requests. Prod declares its own probe identity in site-config.
          agw_client_policies:
            isolation-probe:
              tokens_per_hour: 50
            mcp-self: { tokens_per_hour: 500000 }
          # Budget tiers: platform_admins identities are tier admin; another identity joins a tier with
          # agw_client_policies.<name>.tier. Its own tokens_per_hour still wins.
          agw_tier_tokens_per_hour:
            admin: 1000000000
            developer: 500000000
            business: 250000000
          # MCP (agentgateway-mcp): the key-gated /mcp endpoint on the default gateway. OFF by default:
          # false renders no mcp block and no loopback gateway, and the verify asserts /mcp is not served.
          # /mcp admits the PERSONAL ADMIN identities only (derived from platform_admins), never an
          # agw_clients service client: the chat tool's call runs as mcp-self, so a service client on
          # /mcp would escape its own allowedModels and hourly budget. Turning it on therefore needs
          # agw_admin_identities_enabled: true with platform_admins declared for this host, no
          # allowed_models on an admin identity, and agw_client_policies.mcp-self.tokens_per_hour (the
          # aggregate cap on every model request made through MCP); the deploy refuses otherwise.
          agw_mcp_enabled: false
          # The hostname Caddy fronts /mcp on (the Caddy route is section 5 of the change; the gateway
          # deploy does not read it).
          agw_mcp_hostname: mcp.agent-cloud.test
          # The loopback gateway's port: plain HTTP, attached to the LLM surface only, restricted to the
          # container's own address, never published. It is where the MCP target calls /v1.
          agw_loopback_port: 4002
          # The MCP targets: ONLY name + schema (a .json file in
          # platform/services/agentgateway/deployment/mcp-schemas/). Each is rendered as an OpenAPI target
          # over this gateway's own /v1 on the loopback listener; its kind and host are not inputs and
          # anything else is refused before the deploy renders. The first entry is the gateway's own
          # chat-completions and model-listing tools (task 4.3).
          agw_mcp_openapi_targets:
            - { name: gateway, schema: agentgateway-v1.json }
          # LOCAL-DEV ONLY: render key VALUES (not hashes) into config.yaml so the UI's
          # playground lists them as saved keys. Never set in prod inventory.
          agw_plaintext_keys: true
          # true: the deploy refuses an empty upstream key, and the public edge refuses a keyless
          # call. Seed secret/services/agentgateway:vllm_api_key with the local-gateway identity's
          # key (operator step) before deploying.
          agw_upstream_requires_key: true
          # OpenRouter models (change agentgateway-openrouter), OFF here: nothing below is declared
          # until you uncomment it. It is billed per token, so a model is listed by name with its
          # OpenRouter id and only the identities named in agw_openrouter_identities may call it
          # (every other identity is denied it in config.yaml). Needs
          # secret/services/agentgateway:openrouter_api_key (Seed OpenBao Key). The local gateway
          # trusts public roots too (compose.local.yml's combined bundle), so openrouter.ai verifies here.
          #   agw_models:
          #     - { name: qwen3.8-flash-next }
          #     - { name: or-mini, provider: openrouter, upstream_model: openai/gpt-4o-mini }
          #   agw_openrouter_identities: [dev-local]
          #   agw_openrouter_admins: false   # true: every admin-derived identity may call them too
          #   agw_verify_openrouter: false   # true: the deploy spends one 8-token completion to prove it
          # skynet's orchestration API at /skynet/ (agentgateway task 3.3), OFF here. Enable it AFTER
          # Deploy skynet (Local) has run once: this gateway reads skynet's api_token by shared read, so
          # enabling it before skynet is deployed stops this deploy by name. Enabling it also needs a
          # host:port backend and the identities allowed to call it. Those identities also pass /v1 (see
          # the architecture doc, "skynet orchestration route"). Bootstrap forwards these three keys into
          # the Semaphore inventory, so after editing them re-run `make local-bootstrap`, then Deploy
          # agentgateway (Local).
          #   agw_skynet_route_enabled: true
          #   agw_skynet_backend: skynet:8080
          #   agw_skynet_route_identities: [dev-local]

    # honcho - memory API (api + deriver on the CI-built GHCR image, own
    # pgvector Postgres + redis, all internal but the api). /v3 is JWT; /docs
    # is Authentik forward_auth-gated at Caddy. Deploy: make local-deploy-honcho.
    honcho_svc:
      hosts:
        honcho-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: honcho
          monorepo_deploy_path: platform/services/honcho/deployment
          container_engine: podman
          honcho_bind: 127.0.0.1
          honcho_port: 8400   # host debug port; Caddy reaches honcho-api:8000 by name

    # skynet — the orchestration API (tier-2 image, CI-published by digest, plus its own Postgres).
    # Its /skynet/ route is served by the local gateway once agw_skynet_route_enabled is set (see the
    # agentgateway block). Deploy: the Deploy skynet (Local) Semaphore template.
    skynet_svc:
      hosts:
        skynet-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: skynet
          monorepo_deploy_path: platform/services/skynet/deployment
          container_engine: podman
          # skynet main 45fd8698 (2026-10-20); bump to the digest skynet CI prints in its publish job
          # summary, never a tag. The deploy refuses a tag or any non-digest value.
          skynet_image: ghcr.io/uhstray-io/skynet-tier2@sha256:d1460ee9eabd71f1e809a2c05fdb15873c6f6fa4e6d2f7058ccee56179f929da
          skynet_gateway_url: https://inference.agent-cloud.test
          skynet_model: qwen3.8-flash-next
          skynet_opa_url: https://opa.agent-cloud.test
          skynet_semaphore_url: https://semaphore.agent-cloud.test
          # id of the agent-cloud project in local Semaphore
          skynet_semaphore_project: 1
          skynet_semaphore_catalog: local

    # postiz — social-media scheduling and publishing. Five containers: the app
    # (the only one publishing), its own Postgres + Redis, and the Temporal
    # workflow engine + that engine's Postgres. The engine is what executes
    # scheduled publishing. Native OIDC to Authentik
    # (blueprints/postiz-oidc.yaml). Behind Caddy at postiz.agent-cloud.test.
    # Deploy: make local-deploy-postiz.
    postiz_svc:
      hosts:
        postiz-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: postiz
          monorepo_deploy_path: platform/services/postiz/deployment
          container_engine: podman
          postiz_bind: 127.0.0.1
          # Host debug port; Caddy reaches the container :5000 by name. Shifted
          # off 5000 because macOS AirPlay Receiver squats that port by default.
          postiz_port: 5001
          # Search node (Elasticsearch) for the workflow engine — REQUIRED as
          # of postiz v2.23.0 and defaulted true; kept here as the documented
          # opt-out knob. Full account: services/postiz/deployment/CLAUDE.md.
          postiz_temporal_search: true
          # MUST match the URL the browser actually uses — postiz derives its
          # OIDC redirect from this, so a mismatch is rejected by Authentik as an
          # unregistered destination. Includes :8443 unless `make local-https`
          # is running (which serves the same names port-free on :443).
          postiz_public_url: "https://postiz.agent-cloud.test:8443"
          # The IdP base postiz calls server-side for token + userinfo. Same
          # host:port the browser uses, via the caddy route's internal_https_port.
          postiz_authentik_base: "https://auth.agent-cloud.test:8443"
          # NOTE: postiz_redirect_uri / postiz_launch_url are deliberately NOT set
          # here. They are consumed when deploy-authentik renders the blueprint,
          # so they belong on the AUTHENTIK host — and locally the blueprint's own
          # defaults already match these URLs. Prod sets them in site-config on
          # authentik_svc (same convention tududi follows).
          # Open for the FIRST sign-in, then flip to true and redeploy. Upstream
          # allows a single signup then closes; encoding the flip here keeps it
          # reproducible instead of a manual step on the host.
          postiz_disable_registration: false

    # plane — work tracker, Commercial edition. Plane's own Compose file is fetched and
    # sha256-verified per deploy (its EULA forbids committing it); native in-app auth.
    # Behind Caddy at plane.agent-cloud.test. Deploy: local Semaphore "Deploy Plane (Local)".
    plane_svc:
      hosts:
        plane-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: plane
          monorepo_deploy_path: platform/services/plane/deployment
          container_engine: podman
          plane_bind: 127.0.0.1
          # Host debug port only; Caddy reaches the proxy container (plane-proxy:80) by name.
          plane_port: 8096
          # MUST match the URL the browser uses: Plane derives WEB_URL, CORS_ALLOWED_ORIGINS
          # and INTEGRATION_CALLBACK_BASE_URL from it (platform/services/plane/deployment/templates/env.j2).
          # Includes :8443 unless `make local-https` is running.
          plane_public_url: "https://plane.agent-cloud.test:8443"
          plane_trusted_proxies: private_ranges
          plane_automation_email: "plane-automation@agent-cloud.test"
          plane_company_name: "agent-cloud"
          plane_workspace_slug: agent-cloud
          plane_workspace_name: agent-cloud

    # ERPNext — ERP (slim local tier: db + redis x2 + backend + frontend + one
    # worker + scheduler + websocket; MinIO/backup are prod-only). Behind Caddy
    # at erp.agent-cloud.test. frappe/erpnext is multi-arch (arm64 OK).
    erpnext_svc:
      hosts:
        erpnext-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: erpnext
          monorepo_deploy_path: platform/services/erpnext/deployment
          container_engine: podman
          erpnext_bind: 127.0.0.1
          erpnext_port: 8080
          erpnext_version: v16   # moving major tag; pin to a patch + verify at deploy
          erpnext_site_name: erp.agent-cloud.test
          erpnext_public_url: https://erp.agent-cloud.test:8443

    uhhcraft_svc:
      hosts:
        uhhcraft-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: uhhcraft
          service_url: "http://127.0.0.1:3001"
          health_path: "/healthz"
          monorepo_deploy_path: platform/services/uhhcraft/deployment
          container_engine: podman
          uhhcraft_port: 3001

    # Phase 2 coverage — uncomment as services gain local profiles
    # (port map registry of record: docs/LOCAL-DEV.md):
    #
    # nocodb_svc:
    #   hosts:
    #     nocodb-local:
    #       ansible_host: 127.0.0.1
    #       ansible_connection: local
    #       service_name: nocodb
    #       service_url: "http://127.0.0.1:8081"
    #       monorepo_deploy_path: platform/services/nocodb/deployment
    #       container_engine: podman
    #
    # NetBox — IPAM authority, under PODMAN through the local Semaphore (plan 04 "NetBox
    # Local Engine"; change service-deployment-workflow section 6). The forward_auth
    # overlay makes Caddy's Authentik gate the only way in, and the app publishes on
    # loopback only, because the overlay trusts X-authentik-* headers.
    # Deploy: make local-deploy-netbox.
    netbox_svc:
      hosts:
        netbox-local:
          ansible_host: 127.0.0.1
          ansible_connection: local
          service_name: netbox
          service_url: "http://127.0.0.1:8000"
          monorepo_deploy_path: platform/services/netbox/deployment
          container_engine: podman
          netbox_host_ip: 127.0.0.1
          netbox_compose_overlays: [docker-compose.local-auth.yml]
          # Discovery on local-dev only (platform/netbox-local): the pfSense/Proxmox
          # workers reach real infrastructure APIs, so they are off here, and the scans
          # run only on discovery_target_subnet / discovery_targets, each of which the
          # deploy refuses unless it lies inside a network on the local engine. Unset
          # means discovery is disabled. Set the subnet in local-dev.yml, never in the
          # committed example (no private addresses in this repo).
          discovery_workers_enabled: false
          # The engine's seccomp profile for image builds (lib/common.sh build_netbox_image).
          netbox_build_seccomp_profile: /usr/share/containers/seccomp.json
          # podman-compose names containers project_service_N (Docker Compose uses "-").
          netbox_app_container: netbox_netbox_1
          # The orb agent runs with host networking on the engine host: it reaches the local
          # OpenBao on that host's loopback, not by the controller's container network name.
          orb_agent_openbao_addr: "http://127.0.0.1:8200"
          # Containers `Stop Local Service` stops besides the compose project's own: the orb
          # agent is started by tasks/deploy-orb-agent.yml, carries no compose label, and so
          # is not found by the project selector.
          stop_extra_containers: [netbox-orb-agent]
