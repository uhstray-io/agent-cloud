#!/usr/bin/env sh
# agent-cloud commit-msg — refuse AI attribution in commit messages.
#
# Repo rule (AGENTS.md, Git Conventions): "No AI attribution in commits". A coding agent's
# harness can instruct it to append attribution trailers, and on 2026-09-22 one did so on
# six commits, one of which was pushed (docs/MISTAKES.md 5.8). A rule carried by memory
# failed; this hook carries it mechanically. Authorship stays the committer's own identity.
#
# Escape hatch for a reason you can defend in review: git commit --no-verify
msg_file="$1"
if grep -inE '^(co-authored-by:.*(claude|anthropic|openai|codex|copilot|gpt)|claude-session:)|generated with \[?claude code|noreply@anthropic\.com' "$msg_file" >/dev/null; then
  echo "commit-msg: AI attribution found in the commit message — the repo forbids it (AGENTS.md, Git Conventions):" >&2
  grep -inE '^(co-authored-by:.*(claude|anthropic|openai|codex|copilot|gpt)|claude-session:)|generated with \[?claude code|noreply@anthropic\.com' "$msg_file" >&2
  echo "Remove those lines and commit again." >&2
  exit 1
fi
exit 0
