#!/usr/bin/env sh
# agent-cloud pre-commit — two gates, in order of consequence.
#
# Gate 1: the repo's own secret-scanning suite (.pre-commit-config.yaml) —
#   trufflehog, RFC1918 private-IP detection, credential patterns, .env
#   blocking. This is the codified Mandatory Pre-Push Audit from AGENTS.md and
#   it is the gate that must not be lost.
#
#   Why it is invoked from here rather than from .git/hooks/pre-commit: this
#   repo sets `core.hooksPath .githooks` so the repo-memory capture hooks fire
#   for every committer without per-clone setup. That makes git ignore
#   .git/hooks/ entirely — which is where `pre-commit install` writes. So the
#   framework is called directly instead, which has a bonus: the checks run
#   with no `pre-commit install` step at all, they just need the CLI.
#
#   Consequence to know about: while core.hooksPath is set, `pre-commit
#   install` refuses to run ("cowardly refusing"). That is expected — you do
#   not need it. Install the CLI only: pip install pre-commit (or brew).
#
# Gate 2: the repo-memory mechanical lint (vendor-agnostic). No-ops unless
#   .claude/memory/ files are staged AND scripts/repo-memory-lint.ts exists.
#
# Both gates degrade to a no-op when their tool is absent, so a contributor
# without the toolchain is never blocked by a missing dependency — the CI
# Security Scan remains the authoritative backstop either way.

# ── Gate 1: repo secret-scanning suite ──────────────────────────────────────
if [ -f .pre-commit-config.yaml ] && command -v pre-commit >/dev/null 2>&1; then
  pre-commit run --hook-stage pre-commit || exit 1
fi

# ── Gate 2: repo-memory record lint ─────────────────────────────────────────
git diff --cached --quiet -- '.claude/memory' 2>/dev/null && exit 0
command -v node >/dev/null 2>&1 || exit 0
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
script="$root/scripts/repo-memory-lint.ts"
[ -f "$script" ] || exit 0

exec node "$script" --staged
