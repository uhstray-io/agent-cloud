#!/usr/bin/env sh
# agent-cloud pre-push — run the test suites before code leaves the machine.
#
# WHY THIS EXISTS, and why at pre-push rather than pre-commit:
#
# docs/MISTAKES.md §5.2 records "committed while a test was failing, because the check
# did not gate the commit", enforced by "Convention". §5.5 and §5.6 record the same
# mistake happening three more times. Four occurrences of one rule whose enforcement was
# a written note is the argument for making it mechanical.
#
# The gap was structural, not careless: the pre-commit gates cover trufflehog, private
# IPs, credential patterns, .env files, whitespace, EOF, YAML, large files, merge
# conflicts and private keys — and nothing at all about tests. There was no gate to pass.
#
# Pre-push, not pre-commit, because both suites take minutes. On every commit that is
# friction people route around with --no-verify, which converts a gate into a habit of
# bypassing gates. On push it is paid once per batch, at the moment the code stops being
# local — the last point at which a red suite is cheap. Each phase reports its measured
# elapsed time instead of carrying an estimate that goes stale as coverage grows.
#
# FAIL-OPEN when a runner is absent, which is DELIBERATELY the opposite of the
# pre-commit secret gate. That gate fails closed because a leaked secret is irreversible
# and must be treated as compromised. A red test is not irreversible: CI runs both
# suites on every PR and blocks the merge. So a contributor without bats installed is
# warned loudly and allowed to push, rather than blocked from pushing at all by a check
# whose only benefit is earlier feedback.
#
# Escape hatch, explicit and loud:
#   SKIP_TESTS=1 git push ...
#
# WHAT MATCHES CI: the test paths, the working directory, and PYTHONPATH. That much is
# deliberate — a hook that tests something subtly different from CI teaches people to
# distrust it.
#
# WHAT DOES NOT: local execution, and therefore the result. CI pins Python 3.11 via
# actions/setup-python and installs the test dependencies; this hook uses whatever
# `python3` is on the developer's PATH, with whatever is installed there. The pytest
# command also differs in its local interpreter: `python3 -m pytest` ensures collection
# and execution use the same interpreter instead of whichever `pytest` executable is
# first on PATH. Verbose progress names the test currently running, so a slow or stuck
# phase can be located. Full pytest may still be skipped on a missing dependency, but the
# scoped publication module then runs directly as the fail-closed fallback below.
#
# So a green push means the suites passed ON THIS MACHINE, or were skipped. It is not
# evidence they pass in CI, and CI remains the authority. `bats platform/tests/` is the
# one command that is byte-identical to CI's.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

# Git exports its repository variables to hooks. Left set, they point every git command
# a TEST runs at THIS repository, even from a scratch directory: on 2026-09-23 a BATS
# setup's `git init` + `git config` wrote core.bare=true and a fake user.email into the
# shared .git/config, breaking every checkout (docs/MISTAKES.md 3.7). The suites run with
# a clean git environment, exactly as they do in CI. `root` is resolved above, first.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE

# A branch deletion pushes an all-zero local sha and has no code to test. Reading stdin
# also drains it, which git expects.
only_deletions=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    "" ) ;;
    *[!0]* ) only_deletions=0 ;;
  esac
done
[ "$only_deletions" = "1" ] && exit 0

if [ "${SKIP_TESTS:-}" = "1" ]; then
  printf '\n!! TESTS SKIPPED via SKIP_TESTS=1 — the suites did NOT run before this push.\n\n' >&2
  exit 0
fi

failed=0

phase_start() {
  _phase_name=$1
  _phase_started_epoch=$(date +%s)
  printf 'pre-push: %s START at %s\n' "$_phase_name" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >&2
}

phase_end() {
  _phase_status=$1
  _phase_finished_epoch=$(date +%s)
  _phase_elapsed=$((_phase_finished_epoch - _phase_started_epoch))
  printf 'pre-push: %s END status=%s elapsed=%ss at %s\n' \
    "$_phase_name" "$_phase_status" "$_phase_elapsed" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >&2
}

print_missing_dependencies() {
  sed -nE \
    -e "s/.*No module named ['\"]([^'\"]+)['\"].*/          dependency: \\1/p" \
    -e "s/.*ImportError: cannot import name ['\"]([^'\"]+)['\"].*/          dependency: \\1/p"
}

collection_failure_is_missing_dependencies_only() {
  awk '
    /ERROR collecting / { collection_errors++ }
    /^[[:space:]]*(E[[:space:]]+)?ModuleNotFoundError: No module named/ {
      dependency_errors++
      next
    }
    /^[[:space:]]*(E[[:space:]]+)?ImportError: cannot import name/ {
      dependency_errors++
      next
    }
    /: No module named [A-Za-z0-9_.-]+$/ {
      dependency_errors++
      next
    }
    /^[[:space:]]*(E[[:space:]]+)?(([A-Za-z_][A-Za-z0-9_]*\.)*[A-Za-z_][A-Za-z0-9_]*(Error|Exception)):/ {
      non_dependency_error = 1
    }
    /^[[:space:]]*(E[[:space:]]+)?(KeyboardInterrupt|SystemExit|GeneratorExit|Failed|Skipped|Exit):/ {
      non_dependency_error = 1
    }
    /^[[:space:]]*(ERROR:|INTERNALERROR>)/ {
      non_dependency_error = 1
    }
    END {
      if (dependency_errors < 1 || non_dependency_error ||
          (collection_errors > 0 && collection_errors != dependency_errors)) {
        exit 1
      }
    }
  '
}

print_collection_failure_summary() {
  sed -nE \
    -e "s/.*No module named ['\"]([^'\"]+)['\"].*/          dependency: \\1/p" \
    -e "s/.*ImportError: cannot import name ['\"]([^'\"]+)['\"].*/          dependency: \\1/p" \
    -e 's/^[[:space:]]*(E[[:space:]]+)?(([A-Za-z_][A-Za-z0-9_.]*\.)*[A-Za-z_][A-Za-z0-9_]*(Error|Exception)):.*/          collection exception: \2/p' \
    -e 's/^[[:space:]]*(E[[:space:]]+)?(KeyboardInterrupt|SystemExit|GeneratorExit|Failed|Skipped|Exit):.*/          collection exception: \2/p' \
    -e 's/^[[:space:]]*ERROR:.*/          collection error: pytest configuration/p' \
    -e 's/^[[:space:]]*INTERNALERROR>.*/          collection error: pytest internal/p'
}

sanitize_scoped_fallback_output() {
  sed -nE \
    -e 's/^(test_[A-Za-z0-9_]+ \(__main__\.[A-Za-z0-9_.]+\) \.\.\. (ok|FAIL|ERROR))$/          \1/p' \
    -e 's/^(test_[A-Za-z0-9_]+ \(__main__\.[A-Za-z0-9_.]+\)) \.\.\. skipped .*/          \1 ... skipped/p' \
    -e 's/^Ran ([0-9]+) tests? in .*$/          Ran \1 tests/p' \
    -e 's/^(OK|FAILED \([^)]*\))$/          \1/p' \
    -e "s/.*No module named ['\"]([^'\"]+)['\"].*/          dependency: \\1/p" \
    -e "s/.*ImportError: cannot import name ['\"]([^'\"]+)['\"].*/          dependency: \\1/p"
}

# ── BATS ────────────────────────────────────────────────────────────────────
if [ -d platform/tests ]; then
  phase_start "BATS suite"
  if command -v bats >/dev/null 2>&1; then
    if ! bats platform/tests/; then
      failed=1
      phase_end failed
    else
      phase_end passed
    fi
  else
    printf '\n' >&2
    printf 'pre-push WARNING: bats is not installed, so the Bash suite did not run.\n' >&2
    printf '  CI still gates the merge, but you are pushing untested.\n' >&2
    printf '  Install it:  brew install bats-core   (or: apt-get install bats)\n' >&2
    printf '\n' >&2
    phase_end not-run
  fi
fi

# ── pytest ──────────────────────────────────────────────────────────────────
# Run from the REPO ROOT so pyproject's `testpaths` selects the suites, exactly as
# CI does. Passing an explicit path overrides testpaths, so a suite added to that
# list ran nowhere — and running nowhere is indistinguishable from passing.
#
# Its dependencies (pytest, pyyaml, netboxlabs-diode-sdk, proxmoxer, requests) are
# frequently absent locally, so a MISSING DEPENDENCY is a warning rather than a
# failure: refusing the push because a library is not installed would contradict
# the fail-open contract above, and the import error would read as a broken test.
#
# But fail-open applies to that case ONLY. A collection failure also happens when a
# test file has a syntax error, a bad import of its own, or pytest config is
# invalid — and those are defects, not environment gaps. Treating every collection
# failure as "dependency missing" skipped the suite silently and let a genuinely
# broken test module reach CI: exactly how an undeclared `yaml` import took the
# whole Unit Tests job down on PR #136 while nothing locally objected.
#
# RESIDUAL LIMIT, stated rather than papered over: a typo'd import and a genuinely
# missing dependency both raise ModuleNotFoundError and cannot be distinguished from
# the message alone — that would need a dependency manifest to compare against. So
# the complete configured suite still skips in that case, but the scoped publication
# module runs directly and fails closed before the hook can allow the push. Syntax
# errors and invalid config, which are unambiguous defects, fail without fallback.
py_pp=platform/services/netbox/deployment/workers/proxmox_discovery:platform/services/netbox/deployment/workers/pfsense_sync
if [ -f pyproject.toml ]; then
  # COLLECTION decides whether to run, not `import pytest` — and its OUTPUT decides
  # whether a failure is forgivable. Keeping the output means no dependency list has
  # to be maintained here to drift out of step with what the tests actually import.
  phase_start "Python collection"
  collect_out=$(PYTHONPATH="$py_pp" python3 -m pytest -q --collect-only 2>&1)
  collect_rc=$?
  if [ "$collect_rc" -eq 0 ]; then
    phase_end passed
    phase_start "Python suite"
    if ! ( PYTHONPATH="$py_pp" python3 -m pytest -v ); then
      failed=1
      phase_end failed
    else
      phase_end passed
    fi
  elif printf '%s\n' "$collect_out" | collection_failure_is_missing_dependencies_only; then
    phase_end missing-dependency
    printf 'pre-push: Python suite not collectable here — a dependency is missing:\n' >&2
    printf '%s\n' "$collect_out" | print_missing_dependencies >&2
    printf '          Full pytest is skipped locally; running the scoped publication fallback.\n' >&2
    printf '          CI installs the dependencies and runs the complete configured roots.\n' >&2
    printf '          If this names a module the tests legitimately need, DECLARE it in\n' >&2
    printf '          .github/workflows/lint-and-test.yml before pushing.\n' >&2

    phase_start "Scoped publication fallback"
    fallback_out=$(PYTHONPATH="$py_pp" python3 platform/semaphore/tests/test_scoped_publication.py -v 2>&1)
    fallback_rc=$?
    printf '%s\n' "$fallback_out" | sanitize_scoped_fallback_output >&2
    if [ "$fallback_rc" -eq 0 ]; then
      phase_end passed
    else
      phase_end failed
      printf 'pre-push: scoped publication fallback failed with status %s; raw output suppressed.\n' \
        "$fallback_rc" >&2
      failed=1
    fi
  else
    phase_end failed
    printf 'pre-push: Python collection FAILED for a reason that is not a missing\n' >&2
    printf '          dependency — a syntax error, a bad import, or invalid config.\n' >&2
    printf '          That is a defect, not an environment gap, so this does not skip.\n' >&2
    printf '%s\n' "$collect_out" | print_collection_failure_summary >&2
    failed=1
  fi
fi

if [ "$failed" != "0" ]; then
  printf '\n' >&2
  printf 'PUSH BLOCKED: a test suite failed.\n' >&2
  printf '\n' >&2
  printf '  This is docs/MISTAKES.md §5.2 / §5.5 / §5.6 — the mistake recorded four\n' >&2
  printf '  times before this gate existed. Fix the failure, or fix the test if the\n' >&2
  printf '  test is the thing that is wrong (§2.6 — a test that fails for its own\n' >&2
  printf '  reasons teaches people to delete tests).\n' >&2
  printf '\n' >&2
  printf '  Override only if you have a reason you can defend in review:\n' >&2
  printf '      SKIP_TESTS=1 git push ...\n' >&2
  printf '\n' >&2
  exit 1
fi

exit 0
